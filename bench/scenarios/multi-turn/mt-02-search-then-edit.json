{
  "name": "mt-02-search-then-edit",
  "suite": "multi-turn",
  "description": "find the file in one turn, then edit it in the next",
  "approval": "allow",
  "setup": {
    "files": {
      "src/main.cpp": "// TODO: implement\nint main() { return 0; }\n"
    }
  },
  "prompt": "Two turns: locate the TODO, then replace it and verify.",
  "turns": [
    {
      "prompt": "Find the file containing TODO.",
      "fake_replies": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "type": "function",
              "function": {
                "name": "search",
                "arguments": "{\"pattern\":\"TODO\"}"
              }
            }
          ],
          "prompt_tokens": 50,
          "completion_tokens": 10
        },
        {
          "content": "src/main.cpp contains TODO.",
          "prompt_tokens": 60,
          "completion_tokens": 5
        }
      ],
      "oracle": [
        {
          "tool": "search"
        }
      ],
      "checks": {
        "must_contain": [
          "src/main.cpp"
        ]
      }
    },
    {
      "prompt": "Replace TODO with done in src/main.cpp and read it back.",
      "fake_replies": [
        {
          "tool_calls": [
            {
              "id": "c2",
              "type": "function",
              "function": {
                "name": "write",
                "arguments": "{\"path\":\"src/main.cpp\",\"edits\":[{\"old\":\"TODO\",\"new\":\"done\"}]}"
              }
            }
          ],
          "prompt_tokens": 60,
          "completion_tokens": 10
        },
        {
          "tool_calls": [
            {
              "id": "c3",
              "type": "function",
              "function": {
                "name": "read",
                "arguments": "{\"path\":\"src/main.cpp\"}"
              }
            }
          ],
          "prompt_tokens": 70,
          "completion_tokens": 10
        },
        {
          "content": "done",
          "prompt_tokens": 80,
          "completion_tokens": 5
        }
      ],
      "oracle": [
        {
          "tool": "write",
          "args": {
            "path": "src/main.cpp"
          }
        },
        {
          "tool": "read",
          "args": {
            "path": "src/main.cpp"
          }
        }
      ],
      "checks": {
        "must_contain": [
          "done"
        ]
      }
    }
  ],
  "checks": {
    "must_contain": [
      "done"
    ]
  },
  "difficulty": 4,
  "expected_steps": 5
}
