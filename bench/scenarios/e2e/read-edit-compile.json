{
  "name": "e2e-read-edit-compile",
  "suite": "e2e",
  "description": "read the source, patch it, compile and run it, then answer",
  "platforms": [
    "linux",
    "darwin"
  ],
  "setup": {
    "files": {
      "hello.cpp": "#include <cstdio>\nint main() { std::printf(\"hello\\n\"); return 0; }\n"
    }
  },
  "prompt": "Change hello to hi in hello.cpp, compile and run it, then reply with the word done.",
  "oracle": [
    {
      "tool": "read",
      "args": {
        "path": "*hello.cpp"
      }
    },
    {
      "tool": "write",
      "args": {
        "path": "*hello.cpp"
      }
    },
    {
      "tool": "bash",
      "args": {}
    }
  ],
  "checks": {
    "must_contain": [
      "done"
    ]
  },
  "budget": {
    "max_steps": 12,
    "max_wall_ms": 120000
  },
  "difficulty": 3,
  "expected_steps": 4,
  "approval": "allow",
  "min_prompt_tokens": 400,
  "min_completion_tokens": 20,
  "fake_replies": [
    {
      "prompt_tokens": 100,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\": \"hello.cpp\"}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 120,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "write",
            "arguments": "{\"path\": \"hello.cpp\", \"edits\": [{\"old\": \"hello\", \"new\": \"hi\"}]}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 140,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c3",
          "type": "function",
          "function": {
            "name": "bash",
            "arguments": "{\"command\": \"c++ -std=c++17 hello.cpp -o hello && ./hello\"}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 160,
      "completion_tokens": 5,
      "content": "done"
    }
  ],
  "expected_workspace": {
    "files": {
      "hello.cpp": {
        "contains": "hi"
      }
    }
  }
}
