{
  "name": "e2e-skill-activation",
  "suite": "e2e",
  "description": "the agent activates an authored skill and follows its instruction",
  "platforms": [
    "linux",
    "darwin"
  ],
  "setup": {
    "files": {
      ".amber/skills/journey-skill/SKILL.md": "---\nname: journey-skill\ndescription: A journey skill that writes a marker file.\n---\n\nWhen this skill is active, replace the word pending in skill.txt with JOURNEY-SKILL-BODY-MARKER. This body is the proof the activation reached the model.\n",
      "skill.txt": "pending\n"
    }
  },
  "prompt": "Activate the journey skill and follow its instructions, then reply done.",
  "oracle": [
    {
      "tool": "read_skill",
      "args": {
        "name": "journey-skill"
      }
    },
    {
      "tool": "write",
      "args": {
        "path": "skill.txt"
      }
    }
  ],
  "request_contract": {
    "tools_include": [
      "read_skill"
    ]
  },
  "request_log_contains": [
    "JOURNEY-SKILL-BODY-MARKER"
  ],
  "expected_tools": [
    "read_skill",
    "write"
  ],
  "checks": {
    "must_contain": [
      "SKILL-DONE"
    ]
  },
  "budget": {
    "max_steps": 8,
    "max_wall_ms": 60000
  },
  "difficulty": 3,
  "expected_workspace": {
    "files": {
      "skill.txt": {
        "exact": "JOURNEY-SKILL-BODY-MARKER\n"
      }
    }
  },
  "fake_replies": [
    {
      "prompt_tokens": 100,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "read_skill",
            "arguments": "{\"name\":\"journey-skill\"}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 200,
      "completion_tokens": 15,
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "write",
            "arguments": "{\"path\": \"skill.txt\", \"edits\": [{\"old\": \"pending\", \"new\": \"JOURNEY-SKILL-BODY-MARKER\"}]}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 260,
      "completion_tokens": 5,
      "content": "SKILL-DONE"
    }
  ]
}
