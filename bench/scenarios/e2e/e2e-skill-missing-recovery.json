{
  "name": "e2e-skill-missing-recovery",
  "suite": "e2e",
  "description": "an unknown skill is a tool error, and the agent recovers",
  "platforms": [
    "linux",
    "darwin"
  ],
  "setup": {
    "files": {
      "skill.txt": "pending\n"
    }
  },
  "prompt": "Try to activate no-such-skill, then recover and reply.",
  "oracle": [
    {
      "tool": "read_skill",
      "args": {
        "name": "no-such-skill"
      }
    },
    {
      "tool": "write",
      "args": {
        "path": "skill.txt"
      }
    }
  ],
  "request_contract": {
    "tools_include": [
      "read_skill"
    ]
  },
  "request_log_contains": [
    "unknown skill"
  ],
  "checks": {
    "must_contain": [
      "SKILL-MISSING-RECOVERED"
    ]
  },
  "budget": {
    "max_steps": 8,
    "max_wall_ms": 60000
  },
  "difficulty": 2,
  "expected_workspace": {
    "files": {
      "skill.txt": {
        "exact": "RECOVERED\n"
      }
    }
  },
  "fake_replies": [
    {
      "prompt_tokens": 100,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "read_skill",
            "arguments": "{\"name\":\"no-such-skill\"}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 180,
      "completion_tokens": 15,
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "write",
            "arguments": "{\"path\": \"skill.txt\", \"edits\": [{\"old\": \"pending\", \"new\": \"RECOVERED\"}]}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 240,
      "completion_tokens": 5,
      "content": "SKILL-MISSING-RECOVERED"
    }
  ]
}
