{
  "name": "e2e-approval-denied-fallback",
  "suite": "e2e",
  "description": "the gated bash call is denied, the write fallback still completes",
  "platforms": [
    "linux",
    "darwin"
  ],
  "setup": {
    "files": {
      "plan.txt": "old\n"
    }
  },
  "prompt": "Try the shell command, then write new into plan.txt and reply done.",
  "oracle": [
    {
      "tool": "bash",
      "args": {}
    },
    {
      "tool": "write",
      "args": {
        "path": "*plan.txt"
      }
    }
  ],
  "checks": {
    "must_contain": [
      "done"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 60000
  },
  "difficulty": 3,
  "expected_steps": 3,
  "min_prompt_tokens": 300,
  "min_completion_tokens": 10,
  "fake_replies": [
    {
      "prompt_tokens": 100,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "bash",
            "arguments": "{\"command\": \"echo bad > /tmp/amber-e2e-denied-marker\"}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 120,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "write",
            "arguments": "{\"path\": \"plan.txt\", \"edits\": [{\"old\": \"old\", \"new\": \"new\"}]}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 140,
      "completion_tokens": 5,
      "content": "done"
    }
  ],
  "expected_workspace": {
    "files": {
      "plan.txt": {
        "exact": "new\n"
      }
    }
  }
}
