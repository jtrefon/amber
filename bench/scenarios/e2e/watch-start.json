{
  "name": "e2e-watch-start",
  "suite": "e2e",
  "description": "a process watch starts through the tool, the inventory lists it, and the one-shot CLI names the still-running task with exit 3",
  "platforms": [
    "linux",
    "darwin"
  ],
  "prompt": "Start a short process watch, then list the task inventory and reply watch done.",
  "oracle": [
    {
      "tool": "watch"
    },
    {
      "tool": "tasks"
    }
  ],
  "checks": {
    "must_contain": [
      "watch done"
    ]
  },
  "approval": "allow",
  "budget": {
    "max_steps": 8,
    "max_wall_ms": 60000
  },
  "difficulty": 2,
  "expected_steps": 3,
  "min_prompt_tokens": 150,
  "min_completion_tokens": 10,
  "fake_replies": [
    {
      "prompt_tokens": 100,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "watch",
            "arguments": "{\"action\": \"start\", \"profile\": \"process\", \"command\": \"sh -c 'printf WATCH-E2E'\", \"label\": \"e2e-watch\", \"interval_s\": 1, \"deadline_s\": 30}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 120,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "tasks",
            "arguments": "{\"action\": \"list\"}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 140,
      "completion_tokens": 5,
      "content": "watch done"
    }
  ],
  "expected_exit_code": 3
}
