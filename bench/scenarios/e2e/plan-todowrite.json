{
  "name": "e2e-plan-todowrite",
  "suite": "e2e",
  "description": "the plan tool writes the task list and the turn finishes",
  "platforms": [
    "linux",
    "darwin"
  ],
  "prompt": "Write a two-step plan, then reply plan written.",
  "oracle": [
    {
      "tool": "todowrite"
    }
  ],
  "checks": {
    "must_contain": [
      "plan written"
    ]
  },
  "budget": {
    "max_steps": 6,
    "max_wall_ms": 30000
  },
  "difficulty": 1,
  "expected_steps": 2,
  "min_prompt_tokens": 150,
  "min_completion_tokens": 10,
  "fake_replies": [
    {
      "prompt_tokens": 100,
      "completion_tokens": 10,
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "todowrite",
            "arguments": "{\"todos\": [{\"id\": \"1\", \"text\": \"read the tree\", \"status\": \"completed\"}, {\"id\": \"2\", \"text\": \"write the plan\", \"status\": \"in_progress\"}]}"
          }
        }
      ]
    },
    {
      "prompt_tokens": 120,
      "completion_tokens": 5,
      "content": "plan written"
    }
  ]
}
