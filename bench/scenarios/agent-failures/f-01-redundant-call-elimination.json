{
  "name": "f-01-redundant-call-elimination",
  "suite": "agent-failures",
  "description": "identical read twice then the right one; redundancy is measured, not fatal",
  "hermetic_only": true,
  "setup": {
    "files": {
      "a.txt": "hello world",
      "b.txt": "second file"
    }
  },
  "prompt": "what is in a.txt and b.txt",
  "fake_replies": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"a.txt\"}"
          }
        }
      ],
      "prompt_tokens": 50,
      "completion_tokens": 10
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"a.txt\"}"
          }
        }
      ],
      "prompt_tokens": 55,
      "completion_tokens": 10
    },
    {
      "tool_calls": [
        {
          "id": "c3",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"b.txt\"}"
          }
        }
      ],
      "prompt_tokens": 60,
      "completion_tokens": 10
    },
    {
      "content": "done. a.txt contains hello world and b.txt contains second file.",
      "prompt_tokens": 70,
      "completion_tokens": 5
    },
    {
      "content": "yes",
      "prompt_tokens": 1,
      "completion_tokens": 1
    }
  ],
  "oracle": [
    {
      "tool": "read",
      "args": {
        "path": "a.txt"
      }
    },
    {
      "tool": "read",
      "args": {
        "path": "b.txt"
      }
    }
  ],
  "checks": {
    "must_contain": [
      "hello world",
      "second file"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 30000
  }
}
