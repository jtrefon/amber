{
  "name": "f-06-empty-reply-recovery",
  "suite": "agent-failures",
  "description": "the model returns an empty reply; the engine must recover and continue",
  "hermetic_only": true,
  "difficulty": 4,
  "setup": {
    "files": {
      "a.txt": "hello world"
    }
  },
  "prompt": "what is in a.txt",
  "fake_replies": [
    {
      "content": "",
      "prompt_tokens": 40,
      "completion_tokens": 0
    },
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"a.txt\"}"
          }
        }
      ],
      "prompt_tokens": 50,
      "completion_tokens": 10
    },
    {
      "content": "done. a.txt contains hello world.",
      "prompt_tokens": 60,
      "completion_tokens": 5
    },
    {
      "content": "yes",
      "prompt_tokens": 1,
      "completion_tokens": 1
    }
  ],
  "oracle": [
    {
      "tool": "read",
      "args": {
        "path": "*"
      }
    }
  ],
  "checks": {
    "must_contain": [
      "hello world"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 30000
  }
}
