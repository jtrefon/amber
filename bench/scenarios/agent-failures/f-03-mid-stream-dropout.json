{
  "name": "f-03-mid-stream-dropout",
  "suite": "agent-failures",
  "description": "server dies mid-stream; the engine must retry and complete",
  "hermetic_only": true,
  "stream": true,
  "setup": {
    "files": {
      "a.txt": "hello world"
    }
  },
  "prompt": "what is in a.txt",
  "fake_replies": [
    {
      "content": "let me",
      "drop_after_chunks": 2,
      "retryable": true,
      "prompt_tokens": 40,
      "completion_tokens": 5
    },
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"a.txt\"}"
          }
        }
      ],
      "prompt_tokens": 50,
      "completion_tokens": 10
    },
    {
      "content": "done. a.txt contains hello world.",
      "prompt_tokens": 60,
      "completion_tokens": 5
    },
    {
      "content": "yes",
      "prompt_tokens": 1,
      "completion_tokens": 1
    }
  ],
  "oracle": [
    {
      "tool": "read",
      "args": {
        "path": "a.txt"
      }
    }
  ],
  "checks": {
    "must_contain": [
      "hello world"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 30000
  },
  "difficulty": 4,
  "expected_steps": 2
}