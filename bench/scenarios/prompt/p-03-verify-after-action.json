{
  "name": "p-03-verify-after-action",
  "suite": "prompt",
  "description": "after a write the agent must verify the file with the read tool",
  "platforms": [
    "linux",
    "darwin"
  ],
  "setup": {
    "files": {
      "a.txt": "hello\n"
    }
  },
  "prompt": "Use the write tool to append the word world to a.txt, then use the read tool to read it back to verify. Reply with the word done when finished.",
  "oracle": [
    {
      "tool": "write",
      "args": {
        "path": "a.txt"
      },
      "args_subset": true
    },
    {
      "tool": "read",
      "args": {
        "path": "a.txt"
      }
    }
  ],
  "checks": {
    "must_contain": [
      "done"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 120000
  },
  "forbidden_tools": [
    "bash"
  ],
  "fake_replies": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "write",
            "arguments": "{\"path\":\"a.txt\",\"edits\":[{\"old\":\"hello\",\"new\":\"hello world\"}]}"
          }
        }
      ],
      "prompt_tokens": 60,
      "completion_tokens": 10
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"a.txt\"}"
          }
        }
      ],
      "prompt_tokens": 70,
      "completion_tokens": 10
    },
    {
      "content": "done",
      "prompt_tokens": 80,
      "completion_tokens": 5
    }
  ],
  "approval": "allow"
}
