{
  "name": "p-01-envelope-format",
  "suite": "prompt",
  "description": "final answer must close with the mandated done marker",
  "platforms": [
    "linux",
    "darwin"
  ],
  "setup": {
    "files": {
      "a.txt": "hello world"
    }
  },
  "prompt": "Read a.txt and summarize it. Reply with the word done when finished.",
  "oracle": [
    {
      "tool": "read",
      "args": {
        "path": "*a.txt"
      },
      "args_subset": true
    }
  ],
  "prompt_checks": {
    "must_contain": [
      "done"
    ]
  },
  "checks": {
    "must_contain": [
      "done"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 120000
  },
  "difficulty": 2,
  "expected_steps": 2,
  "fake_replies": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"a.txt\"}"
          }
        }
      ],
      "prompt_tokens": 60,
      "completion_tokens": 10
    },
    {
      "content": "done. a.txt is short.",
      "prompt_tokens": 70,
      "completion_tokens": 5
    }
  ],
  "approval": "allow"
}
