{
  "name": "p-05-multi-constraint",
  "suite": "prompt",
  "description": "four simultaneous output constraints; sloppy models lose adherence (one file per line, done on its own line after)",
  "platforms": [
    "linux",
    "darwin"
  ],
  "difficulty": 4,
  "setup": {
    "files": {
      "b.txt": "x",
      "a.txt": "x",
      "c.txt": "x",
      "skip.md": "x"
    }
  },
  "prompt": "List the .txt files in this workspace sorted alphabetically. Constraints: one file per line, no bullet points, no markdown, no introductory text. Reply with the word done on its own line after the list.",
  "checks": {
    "must_contain": [
      "a.txt\nb.txt\nc.txt\ndone"
    ],
    "must_not_contain": [
      "- ",
      "* ",
      "Here",
      "```"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 120000
  },
  "optimal_plan": {
    "bash": 1
  },
  "fake_replies": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "bash",
            "arguments": "{\"command\":\"ls *.txt | sort\"}"
          }
        }
      ],
      "prompt_tokens": 60,
      "completion_tokens": 10
    },
    {
      "content": "a.txt\nb.txt\nc.txt\ndone",
      "prompt_tokens": 70,
      "completion_tokens": 5
    }
  ],
  "approval": "allow"
}
