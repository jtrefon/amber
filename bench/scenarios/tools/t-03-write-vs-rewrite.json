{
  "name": "t-03-write-vs-rewrite",
  "suite": "tools",
  "description": "patch-style write for a small edit; bash is forbidden",
  "platforms": [
    "linux",
    "darwin"
  ],
  "setup": {
    "files": {
      "a.txt": "hello\n"
    }
  },
  "prompt": "Change the word hello to hi in a.txt. Do NOT use bash. Reply with the word done when finished.",
  "oracle": [
    {
      "tool": "read",
      "args": {
        "path": "*a.txt"
      },
      "unordered": true
    },
    {
      "tool": "write",
      "args": {
        "path": "*a.txt"
      },
      "args_subset": true,
      "unordered": true
    }
  ],
  "forbidden_tools": [
    "bash"
  ],
  "checks": {
    "must_contain": [
      "done"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 120000
  },
  "difficulty": 3,
  "expected_steps": 3,
  "fake_replies": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"a.txt\"}"
          }
        }
      ],
      "prompt_tokens": 60,
      "completion_tokens": 10
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "write",
            "arguments": "{\"path\":\"a.txt\",\"edits\":[{\"old\":\"hello\",\"new\":\"hi\"}]}"
          }
        }
      ],
      "prompt_tokens": 70,
      "completion_tokens": 10
    },
    {
      "content": "done",
      "prompt_tokens": 80,
      "completion_tokens": 5
    }
  ],
  "approval": "allow"
}
