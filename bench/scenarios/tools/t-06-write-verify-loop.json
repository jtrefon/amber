{
  "name": "t-06-write-verify-loop",
  "suite": "tools",
  "description": "write, verify, adjust, verify again — multi-round iteration discipline",
  "platforms": [
    "linux",
    "darwin"
  ],
  "difficulty": 4,
  "setup": {
    "files": {
      "notes.txt": "old line\n"
    }
  },
  "prompt": "Replace the line in notes.txt with exactly: new line. Then read it back to verify. Reply with the word done when finished.",
  "oracle": [
    {
      "tool": "write",
      "args": {
        "path": "*notes.txt"
      },
      "args_subset": true
    },
    {
      "tool": "read",
      "args": {
        "path": "*notes.txt"
      }
    }
  ],
  "forbidden_tools": [
    "bash"
  ],
  "checks": {
    "must_contain": [
      "done"
    ]
  },
  "budget": {
    "max_steps": 10,
    "max_wall_ms": 120000
  },
  "fake_replies": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "write",
            "arguments": "{\"path\":\"notes.txt\",\"edits\":[{\"old\":\"old line\",\"new\":\"new line\"}]}"
          }
        }
      ],
      "prompt_tokens": 60,
      "completion_tokens": 10
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"notes.txt\"}"
          }
        }
      ],
      "prompt_tokens": 70,
      "completion_tokens": 10
    },
    {
      "content": "done",
      "prompt_tokens": 80,
      "completion_tokens": 5
    }
  ],
  "approval": "allow"
}
