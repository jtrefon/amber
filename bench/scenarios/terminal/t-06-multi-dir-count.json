{
  "name": "t-06-multi-dir-count",
  "suite": "terminal",
  "description": "count files across two directories; exact number required",
  "platforms": [
    "linux",
    "darwin"
  ],
  "difficulty": 3,
  "setup": {
    "files": {
      "src/a.log": "x",
      "src/b.log": "x",
      "src/c.txt": "x",
      "lib/d.log": "x",
      "lib/e.log": "x",
      "lib/f.md": "x"
    }
  },
  "prompt": "Count the .log files in the src and lib directories combined. Reply with exactly: count=N, then the word done.",
  "checks": {
    "must_contain": [
      "count=4",
      "done"
    ]
  },
  "budget": {
    "max_steps": 12,
    "max_wall_ms": 120000
  },
  "optimal_plan": {
    "bash": 1
  },
  "fake_replies": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "bash",
            "arguments": "{\"command\":\"find src lib -name '*.log' | wc -l\"}"
          }
        }
      ],
      "prompt_tokens": 60,
      "completion_tokens": 10
    },
    {
      "content": "count=4\ndone",
      "prompt_tokens": 70,
      "completion_tokens": 5
    }
  ],
  "approval": "allow"
}
