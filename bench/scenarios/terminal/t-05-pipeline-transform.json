{
  "name": "t-05-pipeline-transform",
  "suite": "terminal",
  "description": "transform a data file with a command pipeline; exact result required",
  "platforms": [
    "linux",
    "darwin"
  ],
  "difficulty": 4,
  "setup": {
    "files": {
      "data.txt": "banana\napple\ncherry\nbanana\napple\nfig\n"
    }
  },
  "prompt": "Sort data.txt lines, remove duplicates, take the 2nd result line, and write it to out.txt. Then read out.txt and report: exactly result=<contents>. Reply with the word done on the next line.",
  "checks": {
    "must_contain": [
      "result=banana",
      "done"
    ]
  },
  "budget": {
    "max_steps": 12,
    "max_wall_ms": 120000
  },
  "optimal_plan": {
    "bash": 1,
    "read": 1
  },
  "fake_replies": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "bash",
            "arguments": "{\"command\":\"sort data.txt | uniq | sed -n '2p' > out.txt\"}"
          }
        }
      ],
      "prompt_tokens": 60,
      "completion_tokens": 10
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "read",
            "arguments": "{\"path\":\"out.txt\"}"
          }
        }
      ],
      "prompt_tokens": 70,
      "completion_tokens": 10
    },
    {
      "content": "result=banana\ndone",
      "prompt_tokens": 80,
      "completion_tokens": 5
    }
  ],
  "approval": "allow"
}
