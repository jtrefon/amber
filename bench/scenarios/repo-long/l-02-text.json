{
  "name": "l-02-text",
  "suite": "repo-long",
  "description": "fix a text helper in a small multi-module library",
  "platforms": [
    "linux",
    "darwin"
  ],
  "template": "repo-long/text",
  "prompt": "Read TASK.md and fix the failing text function. Run `make test`; then reply with the word done.",
  "approval": "allow",
  "policy": {
    "initial": "task",
    "max_transitions": 10,
    "states": {
      "task": {
        "call": {
          "tool": "read",
          "args": {
            "path": "TASK.md"
          }
        },
        "next": "source"
      },
      "source": {
        "call": {
          "tool": "read",
          "args": {
            "path": "text.cpp"
          }
        },
        "next": "fix"
      },
      "fix": {
        "call": {
          "tool": "write",
          "args": {
            "path": "text.cpp",
            "edits": [
              {
                "old": "std::string upper_text(const std::string& text) { return text; }",
                "new": "std::string upper_text(const std::string& text) { std::string out = text; for (char& c : out) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c))); return out; }"
              }
            ]
          }
        },
        "next": "test"
      },
      "test": {
        "call": {
          "tool": "bash",
          "args": {
            "command": "make test"
          }
        },
        "next": "done"
      },
      "done": {
        "final": "done"
      }
    }
  },
  "oracle": [
    {
      "tool": "read",
      "args": {
        "path": "*TASK.md"
      }
    },
    {
      "tool": "write",
      "args": {
        "path": "text.cpp"
      }
    },
    {
      "tool": "bash",
      "args": {
        "command": "make test"
      }
    }
  ],
  "checks": {
    "must_contain": [
      "done"
    ]
  },
  "expected_workspace": {
    "files": {
      "text.cpp": {
        "contains": "std::toupper"
      }
    }
  },
  "optimal_plan": {
    "read": 2,
    "write": 1,
    "bash": 1
  },
  "difficulty": 3,
  "expected_steps": 4,
  "budget": {
    "max_steps": 12,
    "max_wall_ms": 120000
  }
}
