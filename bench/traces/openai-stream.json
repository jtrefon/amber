{
  "schema": 1,
  "provider": "openai",
  "dialect": "openai",
  "description": "A streamed OpenAI-compatible answer with a usage chunk.",
  "exchanges": [
    {
      "id": "stream",
      "match": {
        "path": "/v1/chat/completions",
        "stream": true,
        "roles": [
          "system",
          "user"
        ],
        "system": "Your name is **Amber**"
      },
      "response": {
        "status": 200,
        "content_type": "text/event-stream",
        "body": "data: {\"id\":\"chatcmpl-stream\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":\"fake\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"streamed answer\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-stream\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":\"fake\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":42,\"completion_tokens\":3,\"total_tokens\":45}}\n\ndata: [DONE]\n\n"
      }
    }
  ]
}
