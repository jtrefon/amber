        -:  398:    if (std::find(r.efforts.begin(), r.efforts.end(), configured) != r.efforts.end())
        -:  399:        return configured;
        -:  400:    // The listing named levels but no default: an unlisted configured value is
        -:  401:    // not sent. Omitting is the conservative answer; inventing one of the
        -:  402:    // listed levels could silently disable reasoning (OpenCode's first level is
        -:  403:    // often "none").
        -:  404:    return r.default_effort;
        -:  405:}
        -:  406:
        -:  407:inline std::string effective_reasoning_effort(const Config& cfg) {
        -:  408:    if (!reasoning_control_available(cfg))
        -:  409:        return cfg.model_reasoning.supported ? "on" : "";
        -:  410:    return effective_reasoning_effort(cfg.model_reasoning, cfg.reasoning_effort);
        -:  411:}
        -:  412:
        -:  413:// Whether the model can be asked for this level. `off` is selectable when the
        -:  414:// model advertises a way to disable reasoning; a level is selectable when the
        -:  415:// listing named it (or named no levels, in which case the configured value is
        -:  416:// sent as-is).
        -:  417:inline bool reasoning_effort_allowed(const Config& cfg, const std::string& effort) {
        -:  418:    const ReasoningContract& r = cfg.model_reasoning;
        -:  419:    if (!is_reasoning_effort(effort))
        -:  420:        return false;
        -:  421:    if (!reasoning_control_available(cfg))
        -:  422:        return effort == "off";
        -:  423:    if (effort == "off")
        -:  424:        return !r.mandatory && r.off != ReasoningOff::Unsupported;
        -:  425:    if (!r.effort_levels)
        -:  426:        return false;
        -:  427:    if (r.efforts.empty())
        -:  428:        return true;
        -:  429:    return std::find(r.efforts.begin(), r.efforts.end(), effort) != r.efforts.end();
        -:  430:}
        -:  431:
        -:  432:// Per-request telemetry, surfaced to UIs for the status bar. Filled in after a
        -:  433:// chat/chat_stream call completes. Fields are -1/0 when unknown.
        -:  434:struct Stats {
        -:  435:    double latency_ms = -1;      // time-to-first-byte (server "lag")
        -:  436:    double tps = -1;             // completion tokens / generation time
        -:  437:    long prompt_tokens = -1;     // usage.prompt_tokens (context used)
        -:  438:    long completion_tokens = -1; // usage.completion_tokens
        -:  439:    // Prompt-cache counters (-1 when the provider did not report them).
        -:  440:    // `cache_read_tokens` is the part of the prompt served from cache; a
        -:  441:    // stable prefix should make it grow with the conversation instead of
        -:  442:    // sitting at 0.
        -:  443:    long cache_read_tokens = -1;
        -:  444:    long cache_write_tokens = -1;
        -:  445:    // The provider's own id for the response, and its explanation when the
        -:  446:    // cache prefix diverged from the previous request.
        -:  447:    std::string response_id;
        -:  448:    std::string cache_miss_reason;
        -:  449:    bool valid = false; // true once a request populated it
        -:  450:};
        -:  451:
        -:  452:// Port: a chat backend over an OpenAI-compatible endpoint. The library does
        -:  453:// not own conversation state; callers pass the full message list each turn.
        -:  454:// Implementations: HttpLLMClient (libcurl) and FakeLLMClient (tests).
        -:  455:// A typed transport failure for the retry policy: `retryable` errors (curl
        -:  456:// failures, timeouts, empty bodies, HTTP 429/5xx) may be retried with
        -:  457:// backoff; non-retryable ones (auth/misconfig 4xx) must fail fast.
        -:  458:// Thrown when the caller's CancellationToken fires mid-request. Distinct
        -:  459:// from ApiError so cancellation is never classified as a retryable failure
        -:  460:// and never degrades into a fabricated assistant message.
        -:  461:struct CancelledError : std::runtime_error {
        -:  462:    using std::runtime_error::runtime_error;
        -:  463:};
        -:  464:
        -:  465:struct ApiError : std::runtime_error {
        -:  466:    long status = 0;
        -:  467:    bool retryable = true;
        -:  468:    long retry_after_ms = 0; // Retry-After header, 0 when absent
        -:  469:    ApiError(long s, bool r, const std::string& msg, long retry_after = 0)
        -:  470:        : std::runtime_error(msg), status(s), retryable(r), retry_after_ms(retry_after) {}
        -:  471:};
        -:  472:
        -:  473:class LLMClient {
        -:  474:public:
        -:  475:    virtual ~LLMClient() = default;
        -:  476:
        -:  477:    // Query the server's GET /v1/models endpoint and report the first model's
        -:  478:    // id and context window (n_ctx). Never throws: on any transport/parse
        -:  479:    // failure it returns a ServerInfo with ok == false.
        -:  480:    virtual ServerInfo probe_server() const = 0;
        -:  481:
        -:  482:    // Buffered request: returns the full assistant message (may include
        -:  483:    // tool_calls). Throws std::runtime_error on transport/API failure. When
        -:  484:    // `stats` is non-null it is filled with per-request telemetry.
        -:  485:    virtual Message chat(const std::vector<Message>& messages,
        -:  486:                         const std::vector<std::shared_ptr<Tool>>& tools,
        -:  487:                         Stats* stats = nullptr) = 0;
        -:  488:
        -:  489:    // Streaming request: invokes `on_chunk` for every parsed SSE event and
        -:  490:    // returns the assembled assistant message. The callback receives partial
        -:  491:    // text as it arrives, enabling live TUI rendering. When `stats` is non-null
        -:  492:    // it is filled with per-request telemetry after completion.
        -:  493:    virtual Message chat_stream(const std::vector<Message>& messages,
        -:  494:                                const std::vector<std::shared_ptr<Tool>>& tools,
        -:  495:                                const std::function<void(const StreamChunk&)>& on_chunk,
        -:  496:                                Stats* stats = nullptr) = 0;
        -:  497:
        -:  498:    // Context window the server taught us via a 400 overflow rejection
        -:  499:    // (parse_context_size_from_error), or 0 when none was learned yet.
        -:  500:    // The learned limit is the runtime truth: it clamps any configured or
        -:  501:    // probed window so the gate and gauge never overshoot.
        -:  502:    virtual int learned_context_size() const { return 0; }
        -:  503:
        -:  504:    // Facts the client accumulated while working that the model has a right to
        -:  505:    // know — a window the server clamped, tool calls it had to drop. The agent
        -:  506:    // drains these into [harness] notices, so nothing about a request changes
        -:  507:    // behind the model's back. Draining empties the list.
        -:  508:    virtual std::vector<std::string> take_notices() { return {}; }
        -:  509:
        -:  510:    // The conversation id a provider may ask for in a request header. The host
        -:  511:    // calls this when its window/session identity changes; a client that does
        -:  512:    // not speak HTTP ignores it, and the default keeps injected test clients
        -:  513:    // untouched.
        -:  514:    virtual void set_session_id(const std::string& id) { (void)id; }
        -:  515:};
        -:  516:
        -:  517:// Real libcurl implementation. The wire protocol (URLs, auth, request body,
        -:  518:// response parsing, streaming, model listing, error classification) is the
        -:  519:// injected Dialect's; this class owns the transport and the assembled
        -:  520:// conversation view. Supports both buffered (chat) and streamed (chat_stream)
        -:  521:// modes.
        -:  522:class HttpLLMClient : public LLMClient {
        -:  523:public:
        -:  524:    explicit HttpLLMClient(Config cfg);
        -:  525:    // `dialect` drives the wire protocol; the one-argument form resolves
        -:  526:    // make_dialect(cfg.flavor). Pass one explicitly in tests or for future
        -:  527:    // plugin providers.
        -:  528:    HttpLLMClient(Config cfg, std::unique_ptr<Dialect> dialect);
        -:  529:    ~HttpLLMClient() override;
        -:  530:
        -:  531:    ServerInfo probe_server() const override;
        -:  532:    Message chat(const std::vector<Message>& messages,
        -:  533:                 const std::vector<std::shared_ptr<Tool>>& tools, Stats* stats = nullptr) override;
        -:  534:    Message chat_stream(const std::vector<Message>& messages,
        -:  535:                        const std::vector<std::shared_ptr<Tool>>& tools,
        -:  536:                        const std::function<void(const StreamChunk&)>& on_chunk,
        -:  537:                        Stats* stats = nullptr) override;
        -:  538:    int learned_context_size() const override { return learned_; }
        -:  539:    std::vector<std::string> take_notices() override;
        -:  540:    // Carried into every subsequent request, so a host that assigns the
        -:  541:    // window's identity after construction still sends it.
        -:  542:    void set_session_id(const std::string& id) override { cfg_.session_id = id; }
        -:  543:
        -:  544:private:
        -:  545:    void add_notice(std::string text);
        -:  546:    // A 400 that names a cache field means the provider (or a proxy) will not
        -:  547:    // take that field. Turn the narrowest one off, leave a notice, and let the
        -:  548:    // caller retry once. False means the error was not about the cache shape.
        -:  549:    bool degrade_cache_for(const ApiError& error);
        -:  550:
        -:  551:    Config cfg_;
        -:  552:    std::unique_ptr<Dialect> dialect_;
        -:  553:    int learned_ = 0; // window taught by a 400 overflow rejection
        -:  554:    std::mutex notices_mtx_;
        -:  555:    std::vector<std::string> notices_;
        -:  556:};
        -:  557:
        -:  558:// A one-line warning when a user-pinned context window contradicts the model
        -:  559:// listing by more than 10%. Empty when there is no pin, the listing has no
        -:  560:// window, or the values agree. The pin is never overridden; the warning makes
        -:  561:// an informed override possible.
        -:  562:std::string context_pin_mismatch(const Config& cfg, const ServerInfo& info);
        -:  563:
        -:  564:// Merge probed server info into a Config, filling ONLY values the user did not
        -:  565:// set explicitly (model_explicit / context_explicit). Pure and network-free so
        -:  566:// the auto-detect policy can be unit-tested. A non-ok / empty info is a no-op.
        -:  567:// `note` optionally receives `context_pin_mismatch()` for the host to surface.
        -:  568:void merge_server_info(Config& cfg, const ServerInfo& info, std::string* note = nullptr);
        -:  569:
        -:  570:// Fill in any auto-detectable Config values (model, context_size) that were
        -:  571:// NOT set explicitly by the user, from the model catalog. Returns the
        -:  572:// ServerInfo parsed (ok == false when no catalog entry parses). Blocking
        -:  573:// (cache-through, single-flight); force=true always revalidates over the
        -:  574:// network — see model_probe.h for the cache and the non-blocking variants.
        -:  575:ServerInfo apply_server_autodetect(Config& cfg, bool force = false);
        -:  576:
        -:  577:} // namespace agent
        -:  578:
        -:  579:#endif // AGENT_LLM_H
