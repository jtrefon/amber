        -:   17:
        -:   18:// A single message in the conversation. role is one of:
        -:   19://   "system", "user", "assistant", "tool"
        -:   20:struct Message {
        -:   21:    std::string role;
        -:   22:    std::string content;
        -:   23:    // Assistant thinking. Replayed on later turns when the provider requires it
        -:   24:    // (DeepSeek's reasoning_content, OpenRouter's reasoning string); otherwise
        -:   25:    // it stays local to the UI.
        -:   26:    std::string reasoning;
        -:   27:    std::string tool_call_id; // for role == "tool"
        -:   28:    std::string name;         // tool name for tool messages
        -:   29:    json tool_calls;          // assistant messages may carry calls
        -:   30:    // True for a notice the harness itself authored ([harness] prefix): a
        -:   31:    // retry summary, a repair report, a budget note. It rides the user channel
        -:   32:    // because every dialect hoists system messages into the leading block: a
        -:   33:    // notice must keep its place in the conversation, and the same rule keeps a
        -:   34:    // volatile prompt block (the session brief, an activated skill body, a
        -:   35:    // plugin tail block) out of the cached prefix. The flag is what keeps the
        -:   36:    // text from being mistaken for the model's own close.
        -:   37:    bool harness = false;
        -:   38:    // When the harness authored this notice because a request failed, the raw
        -:   39:    // failure it reports (transport error, HTTP status). Empty for ordinary
        -:   40:    // guidance, and deliberately not serialized: it describes the turn, not the
        -:   41:    // conversation.
        -:   42:    std::string failure_detail{};
        -:   43:    // A rate-limit failure is a stop signal, not a retryable turn: the status
        -:   44:    // and Retry-After let the loop end instead of asking the model to continue.
        -:   45:    long failure_status = 0;
        -:   46:    long failure_retry_after_ms = 0;
        -:   47:    // The assistant turn exactly as a protocol sent it, when the protocol has
        -:   48:    // content blocks that cannot be reconstructed from text and tool calls.
        -:   49:    // Anthropic signs thinking blocks and rejects a tool-use turn that replays
        -:   50:    // them modified or omits them, so the raw blocks travel with the message.
        -:   51:    // Protocols without such blocks leave this null and never read it.
        -:   52:    json raw_content{};
        -:   53:    // The provider's structured reasoning blocks, replayed verbatim when the
        -:   54:    // listing asks for them (OpenRouter's reasoning_details). Empty when the
        -:   55:    // protocol has no such shape.
        -:   56:    json reasoning_details{};
        -:   57:    // The assistant-message field the reasoning actually arrived in
        -:   58:    // (reasoning_content, reasoning, ...). A cold catalogue can still replay
        -:   59:    // the provider's own field instead of guessing one.
        -:   60:    std::string reasoning_field;
        -:   61:};
