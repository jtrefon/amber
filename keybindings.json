{
  "version": 2,
  "bindings": [
    {"key": "alt+0", "action": "core.panel", "scope": "global"},
    {"key": "alt+1", "action": "core.window.set", "arg": "1", "scope": "global"},
    {"key": "alt+2", "action": "core.window.set", "arg": "2", "scope": "global"},
    {"key": "alt+3", "action": "core.window.set", "arg": "3", "scope": "global"},
    {"key": "alt+4", "action": "core.window.set", "arg": "4", "scope": "global"},
    {"key": "alt+5", "action": "core.window.set", "arg": "5", "scope": "global"},
    {"key": "alt+6", "action": "core.window.set", "arg": "6", "scope": "global"},
    {"key": "alt+7", "action": "core.window.set", "arg": "7", "scope": "global"},
    {"key": "alt+8", "action": "core.window.set", "arg": "8", "scope": "global"},
    {"key": "alt+9", "action": "core.window.set", "arg": "9", "scope": "global"},
    {"key": "ctrl+n", "action": "core.window.new", "scope": "global"},
    {"key": "ctrl+c", "action": "ui.cancel_or_quit", "scope": "global"},
    {"key": "ctrl+w", "action": "ui.input.delete_word", "scope": "input"},
    {"key": "alt+b", "action": "ui.input.delete_word", "scope": "input"},
    {"key": "esc+b", "action": "ui.input.delete_word", "scope": "input"},
    {"key": "alt+m", "action": "ui.mouse.toggle", "scope": "global"},
    {"key": "esc+m", "action": "ui.mouse.toggle", "scope": "global"},
    {"key": "esc+1", "action": "core.window.set", "arg": "1", "scope": "global"},
    {"key": "esc+2", "action": "core.window.set", "arg": "2", "scope": "global"},
    {"key": "esc+3", "action": "core.window.set", "arg": "3", "scope": "global"},
    {"key": "esc+4", "action": "core.window.set", "arg": "4", "scope": "global"},
    {"key": "esc+5", "action": "core.window.set", "arg": "5", "scope": "global"},
    {"key": "esc+6", "action": "core.window.set", "arg": "6", "scope": "global"},
    {"key": "esc+7", "action": "core.window.set", "arg": "7", "scope": "global"},
    {"key": "esc+8", "action": "core.window.set", "arg": "8", "scope": "global"},
    {"key": "esc+9", "action": "core.window.set", "arg": "9", "scope": "global"},
    {"key": "esc", "when": "drawer", "action": "ui.escape", "arg": "drawer", "scope": "input"},
    {"key": "esc", "when": "busy", "action": "ui.escape", "arg": "busy", "scope": "global"},
    {"key": "esc", "when": "idle", "action": "ui.escape", "arg": "idle", "scope": "global"}
  ]
}
