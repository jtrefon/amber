# Maintainer: Jacek Trefon
# Builds amber from the release tag. This recipe is community packaging, not
# part of the signed apt/rpm channels, and it builds from the tag rather than a
# release tarball so there is no checksum to forget when the version moves.
pkgname=amber-agent
pkgver=0.8.0
pkgrel=1
pkgdesc="C++17 AI agent harness: ncurses client, headless CLI, plugin runtime and benchmark harness"
arch=('x86_64')
url="https://github.com/jtrefon/amber"
license=('Apache-2.0')
depends=('curl' 'ncurses')
makedepends=('base-devel' 'git')
source=("git+https://github.com/jtrefon/amber.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd amber
  ./configure --prefix=/usr --libexecdir=/usr/lib --mandir=/usr/share/man
  make
}

check() {
  cd amber
  make test
}

package() {
  cd amber
  make install DESTDIR="${pkgdir}"
}
