---
# clang-tidy configuration for amber (cpp-agent).
# Keep the checks conservative: surface real bugs (null derefs, leaks,
# use-after-move, uninitialized reads) and modernization nits worth taking,
# without noisy style opinions (clang-format owns style) or pedantic
# identifier checks that clash with this codebase's conventions.
# Note: no '#' comment lines are allowed inside the folded 'Checks: >' scalar.
# Struct field reordering for padding is churn with no functional gain
# (clang-analyzer-optin.performance.Padding is disabled below).
#
# bugprone-exception-escape is off deliberately. It reports two categories that
# are not defects in this codebase:
#   1. The noexcept accessors AGENTS.md mandates ("Every Tool::name(),
#      is_read_only(), requires_approval(), SearchBackend::name() ... should be
#      noexcept"). They return std::string, so the convention is noexcept even
#      though allocation can throw bad_alloc.
#   2. Lambdas that capture a throwing-copy type by value and are stored in a
#      std::function. The closure's *copy* constructor is analysed as if it were
#      a move constructor, and only move constructors must not throw. Repro:
#      `[owner] {}` capturing a std::string is flagged with an empty body, while
#      `[n] {}` (int) and `[&owner]` are not, and marking the lambda `noexcept`
#      does not help.
# It is also libc++-dependent: CI (libstdc++) reports zero findings where macOS
# reports ~57. Everything that was a genuine lie — noexcept on allocating
# non-accessor functions, throwing main()s and a destructor — was fixed rather
# than suppressed; see docs/issues.md CX9.
Checks: >
  -*,
  bugprone-*,
  -bugprone-exception-escape,
  performance-*,
  modernize-*,
  readability-*,
  clang-analyzer-*,
  misc-unused-alias-decls,
  misc-unused-parameters,
  misc-unused-using-decls,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-convert-member-functions-to-static,
  -readability-avoid-const-params-in-decls,
  -bugprone-easily-swappable-parameters,
  -performance-no-int-to-ptr,
  -modernize-use-nodiscard,
  -readability-function-cognitive-complexity,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -readability-named-parameter,
  -readability-qualified-auto,
  -readability-suspicious-call-argument,
  -readability-isolate-declaration,
  -readability-use-std-min-max,
  -modernize-avoid-c-arrays,
  -clang-analyzer-optin.performance.Padding,
  -readability-uppercase-literal-suffix,
   -performance-unnecessary-copy-initialization,
   -bugprone-narrowing-conversions,
   -modernize-concat-nested-namespaces,
   -performance-enum-size,
   -readability-redundant-member-init,
   -readability-make-member-function-const,
   -bugprone-empty-catch,
   -readability-avoid-nested-conditional-operator,
   -readability-enum-initial-value,
   -cppcoreguidelines-*,
   -google-*,
   -abseil-*

WarningsAsErrors: ''
HeaderFilterRegex: 'include/agent/.*\.h|tui/.*\.h'
FormatStyle: file
