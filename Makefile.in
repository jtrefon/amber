            $(BUILD_DIR)/tui/confirm_panel.o \
             $(BUILD_DIR)/tui/menu_select.o \
             $(BUILD_DIR)/tui/session_browser_core.o \
             $(BUILD_DIR)/tui/textutil.o \
            $(BUILD_DIR)/tui/palette.o \
            $(BUILD_DIR)/tui/welcome.o \
            $(BUILD_DIR)/tui/rich.o \
            $(BUILD_DIR)/tui/markdown.o \
            $(BUILD_DIR)/tui/markdown_md4c.o \
            $(BUILD_DIR)/tui/canvas.o \
            $(BUILD_DIR)/third_party/md4c/md4c.o
TEST_OBJ  = $(BUILD_DIR)/src/smoketest.o
UNITTEST_OBJ = $(BUILD_DIR)/tests/run_tests.o \
               $(BUILD_DIR)/tests/skill_file_test.o \
               $(BUILD_DIR)/tests/skill_catalog_test.o \
               $(BUILD_DIR)/tests/mcp_transport_test.o \
               $(BUILD_DIR)/tests/mcp_client_test.o \
               $(BUILD_DIR)/tests/mcp_config_test.o \
               $(BUILD_DIR)/tests/mcp_tools_test.o \
               $(BUILD_DIR)/tests/learn_commands_test.o \
               $(BUILD_DIR)/tests/agent_loop_test.o \
               $(BUILD_DIR)/tests/event_bus_test.o \
               $(BUILD_DIR)/tests/plugin_v2_test.o \
               $(BUILD_DIR)/tests/metrics_plugin_test.o
TUI_TEST_OBJ = $(BUILD_DIR)/tests/tui_tests.o
CL_TEST_OBJ  = $(BUILD_DIR)/tests/command_line_test.o
SB_TEST_OBJ  = $(BUILD_DIR)/tests/session_browser_test.o
E2E_TEST_OBJ = $(BUILD_DIR)/tests/e2e_test.o
COMP_TEST_OBJ = $(BUILD_DIR)/tests/completions_test.o
PLUGIN_TEST_OBJ = $(BUILD_DIR)/tests/plugin_test.o
BENCH_TEST_OBJ = $(BUILD_DIR)/tests/bench_test.o

CORE_LIB  = libagent_core.a
TOOLS_LIB = libagent_tools.a
CLI_BIN   = amber-cli
TUI_BIN   = amber
BENCH_BIN = amber-bench

# ncurses (+ form/menu/panel) for the TUI client (detected at configure time).
NCURSES_LIBS = @NCURSES_LIBS@
NCURSES_CFLAGS = @NCURSES_CFLAGS@

.PHONY: all lib cli tui bench check test lint analyze duplicates clean install uninstall

# Lint sources: every project translation unit, third_party excluded.
LINT_SRCS = $(wildcard $(SRC_DIR)/lib/*.cpp) \
            $(wildcard $(SRC_DIR)/src/*.cpp) \
            $(wildcard $(SRC_DIR)/bench/*.cpp) \
            $(wildcard $(SRC_DIR)/tools/*.cpp) \
            $(wildcard $(SRC_DIR)/tools/search/*.cpp) \
            $(wildcard $(SRC_DIR)/tools/plugins/*/*.cpp) \
            $(wildcard $(SRC_DIR)/tui/*.cpp) \
            $(wildcard $(SRC_DIR)/tests/*.cpp)

# Flags shared by the lint tools: same include roots the build uses, plus
# the auto-detected curl/ncurses cflags so headers resolve.
LINT_CXXFLAGS = $(CXXFLAGS) $(CPPFLAGS) $(CURL_CFLAGS) $(NCURSES_CFLAGS) \
                -I$(SRC_DIR)/tools/plugins/cdp

# clang-tidy: per-file static analysis using the project's .clang-tidy config.
# Runs in parallel (one job per CPU core) via xargs -P.
lint:
	@echo "clang-tidy..."
	@export fail=0; \
	 printf '%s\0' $(LINT_SRCS) | \
	 xargs -0 -P$$(nproc) -I{} sh -c \
	    'out=$$(clang-tidy -quiet "{}" -- $(LINT_CXXFLAGS) 2>&1); \
	     if [ -n "$$out" ]; then \
	       echo "$$out" | grep -v "^Suppressed\|^Use -header-filter\|warnings generated" || true; \
	       if echo "$$out" | grep -qv "^Suppressed\|^Use -header-filter\|warnings generated"; then \
	         exit 1; \
	       fi; \
	     fi' _; \
	 rc=$$?; \
	 if [ $$rc -ne 0 ]; then echo "clang-tidy reported findings"; exit 1; fi; \
	 echo "  clean"

# cppcheck: a second, independent static analyzer for defense-in-depth. Runs
# in parallel and ignores the vendored nlohmann/json header (known-good, slow to
# parse). Slower than lint; run explicitly rather than on every build.
ANALYZE_JOBS = $(shell nproc 2>/dev/null || echo 4)
ANALYZE_BUILD_DIR = /tmp/cppcheck_amber
analyze:
	@echo "cppcheck (warning/style/performance/portability/unusedFunction)..."
	@mkdir -p $(ANALYZE_BUILD_DIR)
	@cppcheck --enable=warning,style,performance,portability,unusedFunction --std=c++17 \
	    --cppcheck-build-dir=$(ANALYZE_BUILD_DIR) \
	    --max-ctu-depth=0 -j$(ANALYZE_JOBS) \
	    --suppressions-list=$(SRC_DIR)/cppcheck_suppressions.txt \
	    --suppress=missingIncludeSystem --error-exitcode=1 \
	    -I$(SRC_DIR)/include -I$(SRC_DIR)/src -I$(SRC_DIR)/tools -I$(SRC_DIR) \
	    $(SRC_DIR)/lib $(SRC_DIR)/tools $(SRC_DIR)/tui $(SRC_DIR)/tests 2>/tmp/cp_$$.log; rc=$$?; \
	grep -v "^Checking\|^nofile\|^cppcheck: progress" /tmp/cp_$$.log || true; rm -f /tmp/cp_$$.log; \
	rm -rf $(ANALYZE_BUILD_DIR); \
	exit $$rc

DUPLICATE_MIN_LINES ?= 6
duplicates:
	@echo "python3 duplicate block detector (min $(DUPLICATE_MIN_LINES) lines)..."
	@python3 "$(SRC_DIR)/tools/duplicate_detector.py" --min-lines=$(DUPLICATE_MIN_LINES) $(SRC_DIR)/lib $(SRC_DIR)/tools $(SRC_DIR)/tui $(SRC_DIR)/tests $(SRC_DIR)/src
	@echo "  clean"

SYSINFO_PLUGIN = $(BUILD_DIR)/tools/plugins/sysinfo/sysinfo-plugin
CDP_PLUGIN = $(BUILD_DIR)/tools/plugins/cdp/cdp-plugin
CDP_MAIN_OBJ = $(BUILD_DIR)/tools/plugins/cdp/main.o
CDP_WS_OBJ = $(BUILD_DIR)/tools/plugins/cdp/ws_client.o
WS_TEST_OBJ = $(BUILD_DIR)/tools/plugins/cdp/ws_test.o

all: lib cli tui bench $(SYSINFO_PLUGIN) $(CDP_PLUGIN)

$(BUILD_DIR)/tools/plugins/cdp/%.o: tools/plugins/cdp/%.cpp
	@mkdir -p $(BUILD_DIR)/tools/plugins/cdp
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) -I$(SRC_DIR)/include -Itools/plugins/cdp -c $< -o $@

$(SYSINFO_PLUGIN): tools/plugins/sysinfo/main.cpp
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) -I$(SRC_DIR)/include -o $@ tools/plugins/sysinfo/main.cpp

$(CDP_PLUGIN): $(CDP_MAIN_OBJ) $(CDP_WS_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(CDP_MAIN_OBJ) $(CDP_WS_OBJ)

$(BUILD_DIR)/ws_test: $(WS_TEST_OBJ) $(CDP_WS_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(WS_TEST_OBJ) $(CDP_WS_OBJ)

check: $(BUILD_DIR)/smoketest
	$(BUILD_DIR)/smoketest
	sh $(SRC_DIR)/tests/build_hygiene.sh

test: $(BUILD_DIR)/run_tests $(BUILD_DIR)/command_line_test $(BUILD_DIR)/session_browser_test $(BUILD_DIR)/e2e_test $(BUILD_DIR)/completions_test $(BUILD_DIR)/plugin_test $(BUILD_DIR)/ws_test $(BUILD_DIR)/bench_test $(SYSINFO_PLUGIN) $(CDP_PLUGIN)
	$(BUILD_DIR)/run_tests && $(BUILD_DIR)/command_line_test && $(BUILD_DIR)/session_browser_test && $(BUILD_DIR)/e2e_test && $(BUILD_DIR)/completions_test && $(BUILD_DIR)/plugin_test && $(BUILD_DIR)/ws_test && $(BUILD_DIR)/bench_test

$(BUILD_DIR)/run_tests: $(UNITTEST_OBJ) $(TUI_TEST_OBJ) $(BUILD_DIR)/tui/action_registry.o $(BUILD_DIR)/tui/textutil.o $(BUILD_DIR)/tui/palette.o $(BUILD_DIR)/tui/rich.o $(BUILD_DIR)/tui/markdown.o $(BUILD_DIR)/tui/markdown_md4c.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/tool_display.o $(BUILD_DIR)/tui/setting_registry.o $(BUILD_DIR)/third_party/md4c/md4c.o $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(UNITTEST_OBJ) $(TUI_TEST_OBJ) $(BUILD_DIR)/tui/action_registry.o $(BUILD_DIR)/tui/textutil.o $(BUILD_DIR)/tui/palette.o $(BUILD_DIR)/tui/rich.o $(BUILD_DIR)/tui/markdown.o $(BUILD_DIR)/tui/markdown_md4c.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/tool_display.o $(BUILD_DIR)/tui/setting_registry.o $(BUILD_DIR)/third_party/md4c/md4c.o -Wl,--start-group $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) -Wl,--end-group $(CURL_LIBS)

$(BUILD_DIR)/command_line_test: $(CL_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o
	$(CXX) $(CXXFLAGS) -o $@ $(CL_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o

$(BUILD_DIR)/session_browser_test: $(SB_TEST_OBJ) $(BUILD_DIR)/tui/session_browser_core.o
	$(CXX) $(CXXFLAGS) -o $@ $(SB_TEST_OBJ) $(BUILD_DIR)/tui/session_browser_core.o

$(BUILD_DIR)/e2e_test: $(E2E_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o
	$(CXX) $(CXXFLAGS) -o $@ $(E2E_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o

$(BUILD_DIR)/completions_test: $(COMP_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/setting_registry.o
	$(CXX) $(CXXFLAGS) -o $@ $(COMP_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/setting_registry.o

$(BUILD_DIR)/plugin_test: $(PLUGIN_TEST_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(PLUGIN_TEST_OBJ) -Wl,--start-group $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) -Wl,--end-group $(CURL_LIBS)

$(BUILD_DIR)/bench_test: $(BENCH_TEST_OBJ) $(BENCH_OBJS) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(BENCH_TEST_OBJ) $(BENCH_OBJS) -Wl,--start-group $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) -Wl,--end-group $(CURL_LIBS)

bench: $(BUILD_DIR)/$(BENCH_BIN)

$(BUILD_DIR)/$(BENCH_BIN): $(BENCH_MAIN) $(BENCH_OBJS) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(BENCH_MAIN) $(BENCH_OBJS) -Wl,--start-group $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) -Wl,--end-group $(CURL_LIBS)

$(BUILD_DIR)/smoketest: $(TEST_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(TEST_OBJ) -Wl,--start-group $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) -Wl,--end-group $(CURL_LIBS)

lib: $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)

$(BUILD_DIR)/$(CORE_LIB): $(CORE_OBJS)
	$(AR) rcs $@ $(CORE_OBJS)

$(BUILD_DIR)/$(TOOLS_LIB): $(TOOLS_OBJS)
	$(AR) rcs $@ $(TOOLS_OBJS)

cli: $(BUILD_DIR)/$(CLI_BIN)

$(BUILD_DIR)/$(CLI_BIN): $(CLI_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(CLI_OBJ) \
	    -Wl,--start-group $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) -Wl,--end-group \
	    $(CURL_LIBS)

tui: $(BUILD_DIR)/$(TUI_BIN)

$(BUILD_DIR)/$(TUI_BIN): $(TUI_OBJS) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(TUI_OBJS) \
	    -Wl,--start-group $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) -Wl,--end-group \
	    $(CURL_LIBS) $(NCURSES_LIBS)

# Object compilation rules. The library and tools are compiled once into the
# archive; the CLI/TUI only link against it.
$(BUILD_DIR)/lib/%.o: $(SRC_DIR)/lib/%.cpp
	@mkdir -p $(BUILD_DIR)/lib
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/src/%.o: $(SRC_DIR)/src/%.cpp
	@mkdir -p $(BUILD_DIR)/src
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/bench/%.o: $(SRC_DIR)/bench/%.cpp
	@mkdir -p $(BUILD_DIR)/bench
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/tui/%.o: $(SRC_DIR)/tui/%.cpp
	@mkdir -p $(BUILD_DIR)/tui
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) $(NCURSES_CFLAGS) -c $< -o $@

$(BUILD_DIR)/third_party/md4c/%.o: $(SRC_DIR)/third_party/md4c/%.c
	@mkdir -p $(BUILD_DIR)/third_party/md4c
	$(CC) $(CFLAGS) $(DEPFLAGS) -DMD4C_USE_UTF8 -I$(SRC_DIR)/third_party/md4c -c $< -o $@

$(BUILD_DIR)/tools/%.o: $(SRC_DIR)/tools/%.cpp
	@mkdir -p $(BUILD_DIR)/tools/search
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/plugins/metrics/%.o: $(SRC_DIR)/plugins/metrics/%.cpp
	@mkdir -p $(BUILD_DIR)/plugins/metrics
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/tests/%.o: $(SRC_DIR)/tests/%.cpp
	@mkdir -p $(BUILD_DIR)/tests
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) $(NCURSES_CFLAGS) -c $< -o $@

# Pull in auto-generated header dependencies (ignored if absent, e.g. first run).
-include $(CORE_OBJS:.o=.d)
-include $(TOOLS_OBJS:.o=.d)
-include $(CLI_OBJ:.o=.d)
-include $(BENCH_OBJS:.o=.d)
-include $(BENCH_MAIN:.o=.d)
-include $(TUI_OBJS:.o=.d)
-include $(UNITTEST_OBJ:.o=.d)
-include $(TEST_OBJ:.o=.d)
-include $(BENCH_TEST_OBJ:.o=.d)
-include $(CL_TEST_OBJ:.o=.d)
-include $(SB_TEST_OBJ:.o=.d)
-include $(E2E_TEST_OBJ:.o=.d)
-include $(COMP_TEST_OBJ:.o=.d)
-include $(TUI_TEST_OBJ:.o=.d)
-include $(PLUGIN_TEST_OBJ:.o=.d)
-include $(BUILD_DIR)/third_party/md4c/md4c.d
-include $(WS_TEST_OBJ:.o=.d)
-include $(CDP_WS_OBJ:.o=.d)
-include $(CDP_MAIN_OBJ:.o=.d)
-include $(SYSINFO_PLUGIN).d
-include $(BUILD_DIR)/ws_test.d

datadir    = $(datarootdir)/amber

install: all
	install -d $(DESTDIR)$(bindir)
	install -m 755 $(BUILD_DIR)/$(CLI_BIN) $(DESTDIR)$(bindir)/
	install -m 755 $(BUILD_DIR)/$(TUI_BIN) $(DESTDIR)$(bindir)/
	install -m 755 $(BUILD_DIR)/$(BENCH_BIN) $(DESTDIR)$(bindir)/
	install -d $(DESTDIR)$(libdir)
	install -m 644 $(BUILD_DIR)/$(CORE_LIB) $(DESTDIR)$(libdir)/
	install -m 644 $(BUILD_DIR)/$(TOOLS_LIB) $(DESTDIR)$(libdir)/
	install -d $(DESTDIR)$(includedir)/agent
	install -d $(DESTDIR)$(includedir)/nlohmann
	install -m 644 $(SRC_DIR)/include/agent/*.h $(DESTDIR)$(includedir)/agent/
	install -d $(DESTDIR)$(datadir)/prompts
	install -m 644 prompts/*.md $(DESTDIR)$(datadir)/prompts/
	install -m 644 completions.json $(DESTDIR)$(datadir)/
	install -d $(DESTDIR)$(datadir)/plugins/sysinfo
	install -m 755 $(SYSINFO_PLUGIN) $(DESTDIR)$(datadir)/plugins/sysinfo/
	install -m 644 tools/plugins/sysinfo/manifest.json $(DESTDIR)$(datadir)/plugins/sysinfo/
	install -m 644 $(SRC_DIR)/include/nlohmann/json.hpp $(DESTDIR)$(includedir)/nlohmann/
	install -d $(DESTDIR)$(docdir)
	install -m 644 $(SRC_DIR)/LICENSE $(DESTDIR)$(docdir)/
	install -m 644 $(SRC_DIR)/NOTICE $(DESTDIR)$(docdir)/
	install -m 644 $(SRC_DIR)/THIRD_PARTY_LICENSES $(DESTDIR)$(docdir)/
	install -m 644 $(SRC_DIR)/README.md $(DESTDIR)$(docdir)/

uninstall:
	rm -f $(DESTDIR)$(bindir)/$(CLI_BIN)
	rm -f $(DESTDIR)$(bindir)/$(TUI_BIN)
	rm -f $(DESTDIR)$(bindir)/$(BENCH_BIN)
	rm -f $(DESTDIR)$(libdir)/$(CORE_LIB)
	rm -f $(DESTDIR)$(libdir)/$(TOOLS_LIB)
	rm -rf $(DESTDIR)$(includedir)/agent
	rm -rf $(DESTDIR)$(docdir)

clean:
	rm -f $(BUILD_DIR)/lib/*.o $(BUILD_DIR)/lib/*.d
	rm -f $(BUILD_DIR)/src/*.o $(BUILD_DIR)/src/*.d
	rm -f $(BUILD_DIR)/tui/*.o $(BUILD_DIR)/tui/*.d
	rm -f $(BUILD_DIR)/tests/*.o $(BUILD_DIR)/tests/*.d
	rm -f $(BUILD_DIR)/bench/*.o $(BUILD_DIR)/bench/*.d
	rm -f $(BUILD_DIR)/tools/*.o $(BUILD_DIR)/tools/*.d
	rm -f $(BUILD_DIR)/tools/search/*.o $(BUILD_DIR)/tools/search/*.d
	rm -f $(BUILD_DIR)/third_party/md4c/*.o $(BUILD_DIR)/third_party/md4c/*.d
	rm -f $(SYSINFO_PLUGIN) $(SYSINFO_PLUGIN).d $(CDP_PLUGIN)
	rm -f $(BUILD_DIR)/tools/plugins/cdp/*.o $(BUILD_DIR)/tools/plugins/cdp/*.d
	rm -f $(BUILD_DIR)/plugins/metrics/*.o $(BUILD_DIR)/plugins/metrics/*.d
	rm -f $(BUILD_DIR)/ws_test.d
	rm -f $(CORE_LIB) $(TOOLS_LIB) $(CLI_BIN) $(TUI_BIN) $(BENCH_BIN)
	rm -f $(BUILD_DIR)/run_tests $(BUILD_DIR)/command_line_test $(BUILD_DIR)/session_browser_test $(BUILD_DIR)/e2e_test $(BUILD_DIR)/completions_test $(BUILD_DIR)/plugin_test $(BUILD_DIR)/ws_test $(BUILD_DIR)/bench_test $(BUILD_DIR)/smoketest
	rm -f $(BUILD_DIR)/run_command_line_test $(BUILD_DIR)/run_completions_test $(BUILD_DIR)/run_e2e_test
	rm -f amber-smoke.txt
