BENCH_MAIN = $(BUILD_DIR)/bench/main.o
TUI_OBJS  = $(BUILD_DIR)/tui/tui.o \
            $(BUILD_DIR)/tui/tui_render.o \
            $(BUILD_DIR)/tui/tui_input.o \
            $(BUILD_DIR)/tui/tui_session.o \
            $(BUILD_DIR)/tui/tui_main.o \
            $(BUILD_DIR)/tui/command_line.o \
            $(BUILD_DIR)/tui/action_registry.o \
            $(BUILD_DIR)/tui/drawer_rows.o \
            $(BUILD_DIR)/tui/tool_display.o \
            $(BUILD_DIR)/tui/setting_registry.o \
