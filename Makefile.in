# ncurses (+ form/menu/panel) for the TUI client (detected at configure time).
NCURSES_LIBS = @NCURSES_LIBS@
NCURSES_CFLAGS = @NCURSES_CFLAGS@

.PHONY: all lib cli tui bench check test lint lint-changed lint-baseline-update \
        class-size class-size-update \
        analyze duplicates complexity format-check format-check-changed clean install uninstall

# `make` builds everything. Stated explicitly so a target declared above `all`
# (the lint recipes are) cannot quietly become the default goal: when that
# happened, bare `make` — which CI's build jobs run — stopped building.
.DEFAULT_GOAL := all

# Lint sources: every project translation unit, third_party and tests
# excluded. Tests use harness macros (TEST, ASSERT_EQ) that trigger
# clang-tidy noise without surfacing real bugs; tests are covered by
# `make test`.
LINT_SRCS = $(wildcard $(SRC_DIR)/lib/*.cpp) \
            $(wildcard $(SRC_DIR)/src/*.cpp) \
            $(wildcard $(SRC_DIR)/bench/*.cpp) \
            $(wildcard $(SRC_DIR)/tools/*.cpp) \
            $(wildcard $(SRC_DIR)/tools/search/*.cpp) \
            $(wildcard $(SRC_DIR)/tools/plugins/*/*.cpp) \
            $(wildcard $(SRC_DIR)/tui/*.cpp) \
            $(wildcard $(SRC_DIR)/plugins/*/*.cpp) \
            $(wildcard $(SRC_DIR)/examples/*/*.cpp)

# Flags shared by the lint tools: same include roots the build uses, plus
# the auto-detected curl/ncurses cflags so headers resolve.
LINT_CXXFLAGS = $(CXXFLAGS) $(CPPFLAGS) $(CURL_CFLAGS) $(NCURSES_CFLAGS) \
                -I$(SRC_DIR)/tools/plugins/cdp

# Parallelism for the static-analysis targets: nproc (Linux) or, on macOS,
# sysctl hw.ncpu. Fall back to 4 when neither is available.
NPROC = $(shell nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

# clang-tidy: per-file static analysis using the project's .clang-tidy config.
# Runs in parallel (one job per CPU core) via xargs -P. Files are passed as
# positional args (not -I{}), because BSD xargs caps -I substitution length.
# When compile_commands.json exists (a local convenience, e.g. generated by
# `bear -- make`), clang-tidy picks up exact per-TU flags via -p. It does not
# cache parses — the file only supplies flags, so CI skips generating it and
# always uses the -- $(LINT_CXXFLAGS) fallback below.
#
# Each TU emits a `lint-tidy-tu:<path>` sentinel before it is analysed, and the
# gate is told how many to expect. Zero findings is a legitimate result, so it
# cannot be told apart from a crashed run by counting; the sentinel count can.
# Without this the gate reports green having measured nothing.
CLANG_TIDY ?= clang-tidy
CLANG_TIDY_MIN_VERSION ?= 18.0.0
CLANG_TIDY_MIN_MAJOR := $(word 1,$(subst ., ,$(CLANG_TIDY_MIN_VERSION)))
lint:
	@echo "clang-tidy..."
	@have="$$($(CLANG_TIDY) --version 2>/dev/null | \
	    sed -n 's/.*version \([0-9][0-9.]*\).*/\1/p' | head -1)"; \
	 if [ -z "$$have" ]; then \
	    echo "lint: $(CLANG_TIDY) not found; need >= $(CLANG_TIDY_MIN_VERSION)"; exit 2; \
	 fi; \
	 hmajor=$${have%%.*}; \
	 if [ "$$hmajor" -lt $(CLANG_TIDY_MIN_MAJOR) ]; then \
	    echo "lint: clang-tidy $$have is older than $(CLANG_TIDY_MIN_VERSION); the ratchet \
would be measured against a different check set"; exit 2; \
	 fi
	@if [ -f compile_commands.json ]; then export CTIDY_FLAGS="-p compile_commands.json"; else export CTIDY_FLAGS="-- $(LINT_CXXFLAGS)"; fi; \
	 printf '%s\0' $(LINT_SRCS) | \
	 xargs -0 -P$(NPROC) sh -c ' \
	    for src do \
	      printf "lint-tidy-tu:%s\n" "$$src"; \
	      $(CLANG_TIDY) -quiet "$$src" $$CTIDY_FLAGS 2>&1; \
	    done' _ | \
	 grep -v "^Suppressed\|^Use -header-filter\|warnings generated" | \
	 python3 "$(SRC_DIR)/tools/lint_baseline.py" --check --expect-tu=$(words $(LINT_SRCS))

# Rewrite the lint ratchet after fixing findings. Same collection as `lint`,
# then --update instead of --check, so the baseline can only shrink.
lint-baseline-update:
	@if [ -f compile_commands.json ]; then export CTIDY_FLAGS="-p compile_commands.json"; else export CTIDY_FLAGS="-- $(LINT_CXXFLAGS)"; fi; \
	 printf '%s\0' $(LINT_SRCS) | \
	 xargs -0 -P$(NPROC) sh -c ' \
	    for src do \
	      clang-tidy -quiet "$$src" $$CTIDY_FLAGS 2>&1; \
	    done' _ | \
	 grep -v "^Suppressed\|^Use -header-filter\|warnings generated" | \
	 python3 "$(SRC_DIR)/tools/lint_baseline.py" --update

# Incremental lint: only the TUs the change can actually affect.
# A header change is not a reason to lint the whole tree — tools/affected_tus.py
# asks the compiler for each TU's real dependency list (-MM: preprocess only, no
# codegen, ~0.4 s per TU) and selects the changed .cpp files plus every TU that
# includes a changed header. A .clang-tidy change still lints everything, because
# it changes how every TU is checked.
# Findings go through the same ratchet as `lint` (tools/lint_baseline.py), so a
# baselined finding does not fail the incremental gate either.
# Usage: make lint-changed BASE=origin/main
# Nothing affected → exits 0 immediately.
lint-changed:
	@echo "clang-tidy (incremental, base=$(BASE))..."
	@changed=$$(python3 "$(SRC_DIR)/tools/affected_tus.py" \
	    --base $(BASE) --cxx "$(CXX)" --cxxflags "$(LINT_CXXFLAGS)" $(LINT_SRCS)); \
	 if [ -z "$$changed" ]; then echo "  nothing affected, skipping"; exit 0; fi; \
	 echo "  linting $$(echo "$$changed" | wc -l | tr -d ' ') of $(words $(LINT_SRCS)) TU(s):"; \
	 echo "$$changed" | sed 's/^/    /'; \
	 if [ -f compile_commands.json ]; then export CTIDY_FLAGS="-p compile_commands.json"; else export CTIDY_FLAGS="-- $(LINT_CXXFLAGS)"; fi; \
	 expected=$$(echo "$$changed" | grep -c . ); \
	 printf '%s\0' $$changed | \
	 xargs -0 -P$(NPROC) sh -c ' \
	    for src do \
	      printf "lint-tidy-tu:%s\n" "$$src"; \
	      $(CLANG_TIDY) -quiet "$$src" $$CTIDY_FLAGS 2>&1; \
	    done' _ | \
	 grep -v "^Suppressed\|^Use -header-filter\|warnings generated" | \
	 python3 "$(SRC_DIR)/tools/lint_baseline.py" --check --expect-tu=$$expected

# cpp# ---------------------------------------------------------------------------
# Fuzzing: the only gate that reaches input nobody wrote.
#
# The unit suite, ASan/UBSan and TSan all run against a fixed corpus -- the tests that
# exist. That is the right way to test known behaviour and the wrong way to find the
# bug nobody thought of, and the surface that matters here is fed by a language model:
# SSE framing, MCP JSON-RPC and Markdown all consume bytes we do not control. Sanitizers
# only inspect the inputs they are handed, so without a fuzzer this whole class of defect
# is unreachable by CI.
#
# Not part of `all`: these need a clang with libFuzzer, which the normal build does not.
# Built with coverage instrumentation (fuzzer-no-link) so libFuzzer is guided, and under
# ASan+UBSan so anything it reaches is checked.
#
#   make fuzz       build the three binaries
#   make fuzz-run   run each for FUZZ_RUNS iterations
# ---------------------------------------------------------------------------
FUZZ_CC       ?= clang++
FUZZ_RUNS     ?= 20000
FUZZ_MAX_LEN  ?= 4096
FUZZ_MAX_TIME  ?= 0        # 0 = bound by FUZZ_RUNS only; CI sets 90s per target
FUZZ_BIN      = $(BUILD_DIR)/.fuzz-build
FUZZ_SRC      = $(SRC_DIR)/fuzz

FUZZ_SAN      = -fsanitize=fuzzer,address,undefined
FUZZ_CXXFLAGS = -std=c++17 -g -O1 -MMD -MP -fno-omit-frame-pointer $(FUZZ_SAN) \
                -I$(SRC_DIR)/include -I$(SRC_DIR)/src -I$(SRC_DIR)/tools -I$(SRC_DIR)
FUZZ_NOLINK   = -fsanitize=fuzzer-no-link,address,undefined
# md4c.h #defines its flag bits unconditionally and markdown_md4c.cpp ORs them in at
# parse time, so passing -DMD_FLAG_* here would only redefine them.
FUZZ_MD4C_DEFS = -DMD4C_USE_UTF8

# The markdown path is instrumented end to end, not just at the entry function: a fuzzer
# that cannot see inside rich/textutil is only fuzzing a third of the renderer.
FUZZ_MD_OBJS  = $(FUZZ_BIN)/markdown_md4c.o $(FUZZ_BIN)/markdown.o \
                $(FUZZ_BIN)/markdown_normalize.o $(FUZZ_BIN)/rich.o \
                $(FUZZ_BIN)/textutil.o $(FUZZ_BIN)/ansi_sgr.o
FUZZ_OBJS     = $(FUZZ_BIN)/md4c.o $(FUZZ_BIN)/mcp_jsonrpc.o $(FUZZ_BIN)/stream_decoder.o \
                $(FUZZ_MD_OBJS)

# Apple's clang ships no libFuzzer runtime, so this fails closed rather than looking like
# a pass on a machine that cannot actually fuzz. A stamp rather than a phony target, so a
# build with eight instrumented objects probes once instead of eight times.
$(FUZZ_BIN)/.capability: | $(FUZZ_BIN)
	@if ! printf 'extern "C" int LLVMFuzzerTestOneInput(const unsigned char*, unsigned long){return 0;}' \
	     > $(BUILD_DIR)/.fuzz_probe.cpp 2>/dev/null || \
	   ! $(FUZZ_CC) $(FUZZ_SAN) $(BUILD_DIR)/.fuzz_probe.cpp -o $(BUILD_DIR)/.fuzz_probe \
	     >/dev/null 2>&1; then \
	  echo "fuzz: $(FUZZ_CC) cannot link a libFuzzer binary."; \
	  echo "fuzz: this compiler has no libFuzzer runtime. Apple's clang does not ship one;"; \
	  echo "fuzz: use a real LLVM (brew install llvm, then FUZZ_CC=/opt/homebrew/opt/llvm/bin/clang++)"; \
	  echo "fuzz: or let CI run it. A compiler that cannot fuzz must not report success."; \
	  rm -f $(BUILD_DIR)/.fuzz_probe.cpp $(BUILD_DIR)/.fuzz_probe; \
	  exit 2; \
	fi; \
	rm -f $(BUILD_DIR)/.fuzz_probe.cpp $(BUILD_DIR)/.fuzz_probe; \
	touch $@

FUZZ_CAPABILITY = $(FUZZ_BIN)/.capability

$(FUZZ_BIN):
	@mkdir -p $(FUZZ_BIN)

$(FUZZ_BIN)/%.o: $(SRC_DIR)/lib/%.cpp $(FUZZ_CAPABILITY) | $(FUZZ_BIN)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_NOLINK) -c $< -o $@

$(FUZZ_BIN)/md4c.o: $(SRC_DIR)/third_party/md4c/md4c.c | $(FUZZ_BIN)
	$(FUZZ_CC) -x c -g -O1 -MMD -MP -fno-omit-frame-pointer $(FUZZ_NOLINK) \
	  $(FUZZ_MD4C_DEFS) -c $< -o $@

$(FUZZ_BIN)/markdown_md4c.o: $(SRC_DIR)/tui/markdown_md4c.cpp | $(FUZZ_BIN)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_NOLINK) -c $< -o $@
$(FUZZ_BIN)/markdown.o: $(SRC_DIR)/tui/markdown.cpp | $(FUZZ_BIN)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_NOLINK) -c $< -o $@
$(FUZZ_BIN)/markdown_normalize.o: $(SRC_DIR)/tui/markdown_normalize.cpp | $(FUZZ_BIN)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_NOLINK) -c $< -o $@
$(FUZZ_BIN)/rich.o: $(SRC_DIR)/tui/rich.cpp | $(FUZZ_BIN)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_NOLINK) -c $< -o $@
$(FUZZ_BIN)/textutil.o: $(SRC_DIR)/tui/textutil.cpp | $(FUZZ_BIN)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_NOLINK) -c $< -o $@
$(FUZZ_BIN)/ansi_sgr.o: $(SRC_DIR)/tui/ansi_sgr.cpp | $(FUZZ_BIN)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_NOLINK) -c $< -o $@

FUZZ_TARGETS = mcp_jsonrpc stream_decoder markdown

$(FUZZ_BIN)/fuzz_mcp_jsonrpc: $(FUZZ_SRC)/mcp_jsonrpc.cpp $(FUZZ_BIN)/mcp_jsonrpc.o \
                             $(FUZZ_CAPABILITY) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_SRC)/mcp_jsonrpc.cpp $(FUZZ_BIN)/mcp_jsonrpc.o \
	  $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS) -o $@

$(FUZZ_BIN)/fuzz_stream_decoder: $(FUZZ_SRC)/stream_decoder.cpp $(FUZZ_BIN)/stream_decoder.o \
                               $(FUZZ_CAPABILITY) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_SRC)/stream_decoder.cpp $(FUZZ_BIN)/stream_decoder.o \
	  $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS) -o $@

$(FUZZ_BIN)/fuzz_markdown: $(FUZZ_SRC)/markdown.cpp $(FUZZ_MD_OBJS) $(FUZZ_BIN)/md4c.o \
                           $(FUZZ_CAPABILITY) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(FUZZ_CC) $(FUZZ_CXXFLAGS) $(FUZZ_SRC)/markdown.cpp $(FUZZ_MD_OBJS) \
	  $(FUZZ_BIN)/md4c.o $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS) -o $@

.PHONY: fuzz
fuzz: $(foreach t,$(FUZZ_TARGETS),$(FUZZ_BIN)/fuzz_$(t))
	@echo "built: $(FUZZ_TARGETS)"

.PHONY: fuzz-run
fuzz-run: fuzz
	@rc=0; for t in $(FUZZ_TARGETS); do \
	  mkdir -p $(FUZZ_BIN)/corpus/$$t; \
	  echo "fuzz: $$t ($(FUZZ_RUNS) runs, max_len $(FUZZ_MAX_LEN))"; \
	  $(FUZZ_BIN)/fuzz_$$t $(FUZZ_BIN)/corpus/$$t $(FUZZ_SRC)/corpus/$$t \
	    -runs=$(FUZZ_RUNS) -max_len=$(FUZZ_MAX_LEN) -max_total_time=$(FUZZ_MAX_TIME) \
	    -print_final_stats=1 \
	    -artifact_prefix=$(FUZZ_BIN)/crash- \
	    || { echo "fuzz: $$t FAILED"; rc=1; }; \
	done; \
	if ls $(FUZZ_BIN)/crash-* >/dev/null 2>&1; then \
	  echo "fuzz: crash inputs written to $(FUZZ_BIN)/crash-*"; rc=1; \
	fi; \
	exit $$rc

.PHONY: fuzz-clean
fuzz-clean:
	rm -rf $(FUZZ_BIN)

-include $(FUZZ_OBJS:.o=.d)

# cppcheck: a second, independent static analyzer for defense-in-depth. Runs
# in parallel and ignores the vendored nlohmann/json header (known-good, slow to
# parse). Slower than lint; run explicitly rather than on every build.
ANALYZE_JOBS = $(NPROC)
# cppcheck's build dir is deliberately kept between runs: it re-analyzes only
# files whose hash changed, which turns a ~7 min cold run into ~40 s warm (and
# CI caches it). `rm -rf $(ANALYZE_BUILD_DIR)` for a from-scratch analysis.
ANALYZE_BUILD_DIR = /tmp/cppcheck_amber
# Pinned cppcheck. Checks such as uninitMemberVarNoCtor only exist from 2.21, so
# an older cppcheck silently reports fewer findings and the gate ends up weaker
# than the one CI runs. Fail closed on a stale toolchain rather than pass quietly.
# CI installs exactly this version (see the analyze job in .github/workflows).
CPPCHECK ?= cppcheck
CPPCHECK_MIN_VERSION ?= 2.22.0
CPPCHECK_MIN_MAJOR := $(word 1,$(subst ., ,$(CPPCHECK_MIN_VERSION)))
CPPCHECK_MIN_MINOR := $(word 2,$(subst ., ,$(CPPCHECK_MIN_VERSION)))
# Scanned dirs mirror LINT_SRCS, minus bench/: its scenarios/ hold deliberately
# broken skeletons and references, so analyzing them is pure noise. src/ and
# plugins/ were missing — every plugin was unanalyzed until they were added.
analyze:
	@echo "cppcheck (warning/style/performance/portability/unusedFunction)..."
	@have="$$($(CPPCHECK) --version 2>/dev/null | awk '{print $$NF}')"; \
	if [ -z "$$have" ]; then \
	    echo "analyze: $(CPPCHECK) not found; need >= $(CPPCHECK_MIN_VERSION)"; exit 2; \
	fi; \
	hmaj=$${have%%.*}; hmin=$${have#*.}; hmin=$${hmin%%.*}; \
	if [ "$$hmaj" -lt $(CPPCHECK_MIN_MAJOR) ] || \
	   { [ "$$hmaj" -eq $(CPPCHECK_MIN_MAJOR) ] && [ "$$hmin" -lt $(CPPCHECK_MIN_MINOR) ]; }; then \
	    echo "analyze: cppcheck $$have is older than $(CPPCHECK_MIN_VERSION); newer checks would be skipped"; \
	    exit 2; \
	fi
	@mkdir -p $(ANALYZE_BUILD_DIR)
	@$(CPPCHECK) --enable=warning,style,performance,portability,unusedFunction --std=c++17 \
	    --cppcheck-build-dir=$(ANALYZE_BUILD_DIR) \
	    --max-ctu-depth=0 -j$(ANALYZE_JOBS) \
	    --suppressions-list=$(SRC_DIR)/cppcheck_suppressions.txt \
	    --suppress=missingIncludeSystem --error-exitcode=1 \
	    -I$(SRC_DIR)/include -I$(SRC_DIR)/src -I$(SRC_DIR)/tools -I$(SRC_DIR) \
	    -i$(SRC_DIR)/bench/scenarios \
	    $(SRC_DIR)/lib $(SRC_DIR)/tools $(SRC_DIR)/tui $(SRC_DIR)/bench $(SRC_DIR)/src $(SRC_DIR)/plugins $(SRC_DIR)/tests 2>/tmp/cp_$$$$.log; rc=$$?; \
	grep -v "^Checking\|^nofile\|^cppcheck: progress" /tmp/cp_$$$$.log || true; rm -f /tmp/cp_$$$$.log; \
	exit $$rc

DUPLICATE_MIN_LINES ?= 6
duplicates:
	@echo "python3 duplicate block detector (min $(DUPLICATE_MIN_LINES) lines)..."
	@python3 "$(SRC_DIR)/tools/duplicate_detector.py" --min-lines=$(DUPLICATE_MIN_LINES) --exclude='.*/scenarios/.*' $(SRC_DIR)/lib $(SRC_DIR)/tools $(SRC_DIR)/tui $(SRC_DIR)/tests $(SRC_DIR)/src $(SRC_DIR)/plugins $(SRC_DIR)/bench
	@echo "  clean"

# Complexity gate: a method stays small (NLOC<=40), does not branch excessively
# (CCN<=15) and does not take an unreadable number of parameters (PARAM<=6).
# tests/complexity_baseline.json records the accepted over-limit functions, so
# existing debt cannot grow and a new function must be clean.
#
# Fails closed, including when the measurement degrades: lizard missing, lizard
# exiting non-zero, lizard printing function lines the parser does not recognise,
# or a scan covering implausibly few functions. A cliff with an empty baseline
# that reports "0 over-limit" because it parsed nothing is worse than no gate.
#
# lizard is pinned for the same reason cppcheck is: its -w output is parsed with
# a regex, and its NLOC/CCN arithmetic has changed between releases. An older
# lizard measures differently, which turns every function's recorded size into a
# lie. Override COMPLEXITY_PYTHON when lizard lives in a virtualenv.
LIZARD_MIN_VERSION ?= 1.24.0
LIZARD_MIN_MAJOR := $(word 1,$(subst ., ,$(LIZARD_MIN_VERSION)))
LIZARD_MIN_MINOR := $(word 2,$(subst ., ,$(LIZARD_MIN_VERSION)))

complexity:
	@$(MAKE) --no-print-directory _lizard_version_check
	@$(COMPLEXITY_PYTHON) tools/complexity_gate.py --check

complexity-report:
	@$(COMPLEXITY_PYTHON) tools/complexity_gate.py --report

complexity-update:
	@$(COMPLEXITY_PYTHON) tools/complexity_gate.py --update

# Nesting-depth gate: a function that nests deeply is hard to read no matter how
# short it is, so this is a separate axis from NLOC and CCN. Measured here rather
# than by lizard: lizard's -w output has an `ND` (max_nesting_depth) field, but for
# C++ it is 0 for every function -- verified against a deliberately 6-deep one.
# Gating on it would be a gate permanently green because it measures nothing.
#
# Fails closed like the others: a function whose braces do not close over its own
# extent is reported, not scored, because a wrong zero understates it.
nesting:
	@$(MAKE) --no-print-directory _lizard_version_check
	@$(COMPLEXITY_PYTHON) tools/nesting_gate.py --check

nesting-report:
	@$(MAKE) --no-print-directory _lizard_version_check
	@$(COMPLEXITY_PYTHON) tools/nesting_gate.py --report

nesting-update:
	@$(MAKE) --no-print-directory _lizard_version_check
	@$(COMPLEXITY_PYTHON) tools/nesting_gate.py --update

# One gate report for all of them, as Markdown + JSON. CI uploads it as a build
# artefact (GitHub's equivalent of an ADO build artefact), so a verdict can be
# reviewed from the run page or with `gh run download` instead of by grepping six
# job logs. Runs the gates only; it never gates anything itself, so a failure here
# is a reporting failure and exits 2.
ARTIFACTS_DIR ?= artifacts
GATES_RUN := complexity nesting class-size debt hygiene obfuscation duplicates
# Writes the two report files and, when running under GitHub Actions, appends the
# table to $GITHUB_STEP_SUMMARY so the verdicts render on the run page itself.
# Artefacts alone were not enough: they sit in a panel at the very bottom of the
# run page, below every job, and have to be downloaded -- so a reviewer looking at
# the run saw nothing.
gate-report:
	@mkdir -p $(ARTIFACTS_DIR)
	@python3 "$(SRC_DIR)/tools/gate_report.py" --out $(ARTIFACTS_DIR) --only $(GATES_RUN)

# C++ hygiene: `using namespace` in a header, and raw new/delete (AGENTS.md:
# "Never use raw new/delete"). Both measured clean, so both are cliffs.
HYGIENE_CXX ?= $(CXX)
hygiene:
	@python3 "$(SRC_DIR)/tools/hygiene_gate.py" --check

# Header self-containment: every header must compile on its own. Needs the
# toolchain, and takes ~50s for the tree, so it lives in `check` (which already
# builds) rather than adding a CI job. $(CXX) is passed explicitly: the gate must
# measure with the same compiler the build uses, or a failure is an artefact.
# $(subst) drops the line continuations LINT_CXXFLAGS' definition carries: its
# value spans two lines, and the embedded backslash reaches the compiler as a
# literal filename. Make is what knows these flags, so make expands them.
HYGIENE_CXXFLAGS = $(subst \, ,$(LINT_CXXFLAGS))
hygiene-self-contained:
	@python3 "$(SRC_DIR)/tools/hygiene_gate.py" --check-self-contained \
	    --cxx $(HYGIENE_CXX) --cxxflags "$(HYGIENE_CXXFLAGS)"

hygiene-report:
	@python3 "$(SRC_DIR)/tools/hygiene_gate.py" --report

# Debt-marker gate: no TODO/FIXME/HACK/XXX in owned source. A cliff at zero, so
# there is no baseline to maintain -- it only has to stay there. A marker can be
# acknowledged inline with `debt-allow: <reason>`, and suppressions are counted by
# --report so they cannot accumulate silently.
debt:
	@python3 "$(SRC_DIR)/tools/debt_gate.py" --check

debt-report:
	@python3 "$(SRC_DIR)/tools/debt_gate.py" --report

# Shared by `complexity` and `nesting`: both parse lizard's -w output with a regex
# and both judge success from that output, never from lizard's exit status.
_lizard_version_check:
	@echo "lizard (>= $(LIZARD_MIN_VERSION))..."
	@have="$$($(COMPLEXITY_PYTHON) -m lizard --version 2>/dev/null | head -1 \
	    | tr -d '[:space:]')"; \
	 if [ -z "$$have" ]; then \
	    echo "lizard: not found via '$(COMPLEXITY_PYTHON)'; \
need >= $(LIZARD_MIN_VERSION) (pip install lizard)"; exit 2; \
	 fi; \
	 hmajor=$${have%%.*}; hmin=$${have#*.}; hmin=$${hmin%%.*}; \
	 if [ "$$hmajor" -lt $(LIZARD_MIN_MAJOR) ] || \
	    { [ "$$hmajor" -eq $(LIZARD_MIN_MAJOR) ] && [ "$$hmin" -lt $(LIZARD_MIN_MINOR) ]; }; then \
	    echo "lizard: $$have is older than $(LIZARD_MIN_VERSION); it measures \
NLOC/CCN/nesting differently, so the baseline would be meaningless"; exit 2; \
	 fi

# Tests for the gate tools themselves. They are the only thing standing between
# a silent measurement bug and a green pipeline, and they had none: the
# fail-open behaviour in all three gates went unnoticed precisely because nothing
# exercised them. Stdlib unittest, so this needs no dependency install.
gates-test:
	@echo "gate tool tests..."
	@cd $(SRC_DIR)/tests/gates && python3 -m unittest discover -p 'test_*.py' -v

# clang-format. The tree predates enforcement, so the full-tree run stays
# informational; format-check-changed is the merge gate — files a PR touches
# must be clean, so enforcement ratchets in as code is edited.
#
# Pinned, because it was the last analyzer still tracking the runner image.
# `extra: clang-format` installs the *unversioned* apt metapackage, so the binary
# was whatever ubuntu-latest happened to ship. That happens to agree with the tree
# today (18.1.3 on ubuntu-24.04), which is exactly the problem: the gate is green by
# coincidence. When the image moves, clang-format silently becomes 20.x and the gate
# turns red across the whole repo, for formatting nobody changed. The versions
# disagree on braced-init lists and line-break placement, so this is not
# hypothetical.
#
# Same shape as CLANG_TIDY_MIN_VERSION: CI installs the pinned package and the
# floor fails closed on anything older, so a moved image breaks loudly here instead
# of silently reformatting the tree.
CLANG_FORMAT ?= clang-format
CLANG_FORMAT_MIN_VERSION ?= 18.0.0
CLANG_FORMAT_MIN_MAJOR := $(word 1,$(subst ., ,$(CLANG_FORMAT_MIN_VERSION)))

_clang_format_version_check:
	@have="$$($(CLANG_FORMAT) --version 2>/dev/null | \
	    sed -n 's/.*version \([0-9][0-9.]*\).*/\1/p' | head -1)"; \
	 if [ -z "$$have" ]; then \
	    echo "format-check: $(CLANG_FORMAT) not found; need >= $(CLANG_FORMAT_MIN_VERSION)"; \
	    exit 2; \
	 fi; \
	 hmajor=$${have%%.*}; \
	 if [ "$$hmajor" -lt $(CLANG_FORMAT_MIN_MAJOR) ]; then \
	    echo "format-check: clang-format $$have is older than $(CLANG_FORMAT_MIN_VERSION); \
its output would not match the runner's"; exit 2; \
	 fi

format-check:
	@$(MAKE) --no-print-directory _clang_format_version_check
	@echo "clang-format --dry-run (full tree, informational)..."
	@files=$$(find $(SRC_DIR)/lib $(SRC_DIR)/tools $(SRC_DIR)/tui $(SRC_DIR)/src $(SRC_DIR)/include/agent $(SRC_DIR)/plugins $(SRC_DIR)/tests $(SRC_DIR)/bench -name '*.cpp' -o -name '*.h' | grep -v 'bench/scenarios/' | sort); \
	$(CLANG_FORMAT) --dry-run --Werror $$files 2>&1 | head -n 30; \
	echo "  done (informational)"

# Incremental format gate: clang-format --dry-run --Werror on the .cpp/.h
# files changed since BASE. No C++ changes -> exits 0 immediately.
# bench/scenarios/ is exempt both here and in format-check: fixture code the
# benchmark agent edits and oracles score, not project style.
#
# The changed set is the merge-base-to-HEAD diff PLUS the staged and unstaged
# working-tree diffs. Omitting the latter two is a fail-open: BASE...HEAD sees
# only committed work, so running this on uncommitted changes found nothing to
# check, printed "no C++ changes, skipping" and exited 0 -- a green gate that
# measured nothing, on the files being edited. Correct on CI, misleading locally.
#
# This lives in Makefile.in, not Makefile: Makefile is generated by ./configure and
# gitignored, so an edit made there is lost the next time configure runs.
format-check-changed:
	@$(MAKE) --no-print-directory _clang_format_version_check
	@echo "clang-format (incremental, base=$(BASE))..."
	@changed=$$( { git diff --name-only $(BASE)...HEAD; \
	                git diff --name-only --cached HEAD; \
	                git diff --name-only HEAD; } 2>/dev/null \
	             | grep -E '\.(cpp|h)$$' \
	             | grep -vE 'third_party|bench/scenarios' | sort -u || true); \
	if [ -z "$$changed" ]; then echo "  no C++ changes, skipping"; exit 0; fi; \
	fail=0; \
	for f in $$changed; do \
	  if [ -f "$$f" ]; then \
	    out=$$($(CLANG_FORMAT) --dry-run --Werror "$$f" 2>&1); \
	    if [ -n "$$out" ]; then echo "$$out"; fail=1; fi; \
	  fi; \
	done; \
	if [ $$fail -ne 0 ]; then echo "format-check: violations in changed files"; exit 1; fi; \
	echo "  clean"

SYSINFO_PLUGIN = $(BUILD_DIR)/tools/plugins/sysinfo/sysinfo-plugin
CDP_PLUGIN = $(BUILD_DIR)/tools/plugins/cdp/cdp-plugin
CDP_MAIN_OBJ = $(BUILD_DIR)/tools/plugins/cdp/main.o
CDP_WS_OBJ = $(BUILD_DIR)/tools/plugins/cdp/ws_client.o
WS_TEST_OBJ = $(BUILD_DIR)/tools/plugins/cdp/ws_test.o
CDP_URL_OBJ = $(BUILD_DIR)/tools/plugins/cdp/url.o
URL_TEST_OBJ = $(BUILD_DIR)/tools/plugins/cdp/url_test.o

all: lib cli tui bench $(SYSINFO_PLUGIN) $(CDP_PLUGIN)

$(BUILD_DIR)/tools/plugins/cdp/%.o: tools/plugins/cdp/%.cpp
	@mkdir -p $(BUILD_DIR)/tools/plugins/cdp
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) -I$(SRC_DIR)/include -Itools/plugins/cdp -c $< -o $@

$(SYSINFO_PLUGIN): tools/plugins/sysinfo/main.cpp
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) -I$(SRC_DIR)/include -o $@ tools/plugins/sysinfo/main.cpp

$(CDP_PLUGIN): $(CDP_MAIN_OBJ) $(CDP_WS_OBJ) $(CDP_URL_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(CDP_MAIN_OBJ) $(CDP_WS_OBJ) $(CDP_URL_OBJ)

$(BUILD_DIR)/ws_test: $(WS_TEST_OBJ) $(CDP_WS_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(WS_TEST_OBJ) $(CDP_WS_OBJ)

$(BUILD_DIR)/url_test: $(URL_TEST_OBJ) $(CDP_URL_OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(URL_TEST_OBJ) $(CDP_URL_OBJ)

check: $(BUILD_DIR)/smoketest
	$(BUILD_DIR)/smoketest
	sh $(SRC_DIR)/tests/build_hygiene.sh
	@python3 "$(SRC_DIR)/tools/class_size_gate.py" --check
	@$(MAKE) --no-print-directory nesting
	@python3 "$(SRC_DIR)/tools/debt_gate.py" --check
	@$(MAKE) --no-print-directory hygiene
	@$(MAKE) --no-print-directory hygiene-self-contained HYGIENE_CXX=$(CXX)
	@python3 "$(SRC_DIR)/tools/obfuscation_guard.py"
	@$(MAKE) --no-print-directory gates-test
	@$(MAKE) --no-print-directory gate-report

# Obfuscated-payload guard. Every other gate reads a build or a metric; none of
# them reads file contents, which is how an obfuscated dropper sat in website/
# for months (commit f382c38) with a green build. Scans tracked files only, so
# it needs no build and is cheap enough to run on every PR.
obfuscation:
	@python3 "$(SRC_DIR)/tools/obfuscation_guard.py"

# Class-size ratchet (AGENTS.md: a type should stay under 200 lines). Same
# shape as the complexity and lint gates, so the rule is enforced rather than
# left "in review".
class-size:
	@python3 "$(SRC_DIR)/tools/class_size_gate.py" --report

class-size-update:
	@python3 "$(SRC_DIR)/tools/class_size_gate.py" --update

test: $(BUILD_DIR)/run_tests $(BUILD_DIR)/command_line_test $(BUILD_DIR)/session_browser_test $(BUILD_DIR)/e2e_test $(BUILD_DIR)/completions_test $(BUILD_DIR)/plugin_test $(BUILD_DIR)/ws_test $(BUILD_DIR)/url_test $(BUILD_DIR)/bench_test $(BUILD_DIR)/tui_pty_test $(BUILD_DIR)/$(TUI_BIN) $(SYSINFO_PLUGIN) $(CDP_PLUGIN) $(MCP_FIXTURES)
	$(BUILD_DIR)/run_tests && $(BUILD_DIR)/command_line_test && $(BUILD_DIR)/session_browser_test && $(BUILD_DIR)/e2e_test && $(BUILD_DIR)/completions_test && $(BUILD_DIR)/plugin_test && $(BUILD_DIR)/ws_test && $(BUILD_DIR)/url_test && $(BUILD_DIR)/bench_test && $(BUILD_DIR)/tui_pty_test $(BUILD_DIR)/$(TUI_BIN)

$(BUILD_DIR)/run_tests: $(UNITTEST_OBJ) $(TUI_TEST_OBJ) $(BUILD_DIR)/tui/action_registry.o $(BUILD_DIR)/tui/textutil.o $(BUILD_DIR)/tui/palette.o $(BUILD_DIR)/tui/rich.o $(BUILD_DIR)/tui/markdown.o $(BUILD_DIR)/tui/markdown_md4c.o $(BUILD_DIR)/tui/markdown_normalize.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/tool_display.o $(BUILD_DIR)/tui/scroll_dispatch.o $(BUILD_DIR)/tui/option_key_decode.o $(BUILD_DIR)/tui/status_bar_layout.o $(BUILD_DIR)/tui/toggle_value.o $(BUILD_DIR)/tui/info_dialog_layout.o $(BUILD_DIR)/tui/list_state.o $(BUILD_DIR)/tui/panel_view_state.o $(BUILD_DIR)/tui/form_focus.o $(BUILD_DIR)/tui/session_row.o $(BUILD_DIR)/tui/input_line_layout.o $(BUILD_DIR)/tui/ansi_sgr.o $(BUILD_DIR)/tui/setting_registry.o $(BUILD_DIR)/tui/plugin_commands.o $(BUILD_DIR)/tui/reasoning_block.o $(BUILD_DIR)/tui/plugin_feed.o $(BUILD_DIR)/tui/path_confine.o $(BUILD_DIR)/tui/key_binder.o $(BUILD_DIR)/tui/window_ops.o $(BUILD_DIR)/tui/window_manager.o $(BUILD_DIR)/tui/run_registry.o $(BUILD_DIR)/third_party/md4c/md4c.o $(TEMPLATE_PLUGIN_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(UNITTEST_OBJ) $(TUI_TEST_OBJ) $(BUILD_DIR)/tui/action_registry.o $(BUILD_DIR)/tui/textutil.o $(BUILD_DIR)/tui/palette.o $(BUILD_DIR)/tui/rich.o $(BUILD_DIR)/tui/markdown.o $(BUILD_DIR)/tui/markdown_md4c.o $(BUILD_DIR)/tui/markdown_normalize.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/tool_display.o $(BUILD_DIR)/tui/scroll_dispatch.o $(BUILD_DIR)/tui/option_key_decode.o $(BUILD_DIR)/tui/status_bar_layout.o $(BUILD_DIR)/tui/toggle_value.o $(BUILD_DIR)/tui/info_dialog_layout.o $(BUILD_DIR)/tui/list_state.o $(BUILD_DIR)/tui/panel_view_state.o $(BUILD_DIR)/tui/form_focus.o $(BUILD_DIR)/tui/session_row.o $(BUILD_DIR)/tui/input_line_layout.o $(BUILD_DIR)/tui/ansi_sgr.o $(BUILD_DIR)/tui/setting_registry.o $(BUILD_DIR)/tui/plugin_commands.o $(BUILD_DIR)/tui/reasoning_block.o $(BUILD_DIR)/tui/plugin_feed.o $(BUILD_DIR)/tui/path_confine.o $(BUILD_DIR)/tui/key_binder.o $(BUILD_DIR)/tui/window_ops.o $(BUILD_DIR)/tui/window_manager.o $(BUILD_DIR)/tui/run_registry.o $(BUILD_DIR)/third_party/md4c/md4c.o $(TEMPLATE_PLUGIN_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS)

$(BUILD_DIR)/command_line_test: $(CL_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o
	$(CXX) $(CXXFLAGS) -o $@ $(CL_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o

$(BUILD_DIR)/session_browser_test: $(SB_TEST_OBJ) $(BUILD_DIR)/tui/session_browser_core.o
	$(CXX) $(CXXFLAGS) -o $@ $(SB_TEST_OBJ) $(BUILD_DIR)/tui/session_browser_core.o

# Drives the real TUI in a pty. The fixture is written with SessionStore, so the
# test links the core library the same way plugin_test does.
$(BUILD_DIR)/tui_pty_test: $(PTY_TEST_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(PTY_TEST_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS)

$(BUILD_DIR)/e2e_test: $(E2E_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/setting_registry.o
	$(CXX) $(CXXFLAGS) -o $@ $(E2E_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/setting_registry.o

$(BUILD_DIR)/completions_test: $(COMP_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/setting_registry.o $(BUILD_DIR)/tui/plugin_feed.o $(BUILD_DIR)/tui/help_page.o $(BUILD_DIR)/tui/completion_context.o
	$(CXX) $(CXXFLAGS) -o $@ $(COMP_TEST_OBJ) $(BUILD_DIR)/tui/command_line.o $(BUILD_DIR)/tui/drawer_rows.o $(BUILD_DIR)/tui/setting_registry.o $(BUILD_DIR)/tui/plugin_feed.o $(BUILD_DIR)/tui/help_page.o $(BUILD_DIR)/tui/completion_context.o

$(BUILD_DIR)/plugin_test: $(PLUGIN_TEST_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(PLUGIN_TEST_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS)

$(BUILD_DIR)/bench_test: $(BENCH_TEST_OBJ) $(BENCH_OBJS) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(BENCH_TEST_OBJ) $(BENCH_OBJS) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS)

bench: $(BUILD_DIR)/$(BENCH_BIN)

$(BUILD_DIR)/$(BENCH_BIN): $(BENCH_MAIN) $(BENCH_OBJS) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(BENCH_MAIN) $(BENCH_OBJS) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS)

$(BUILD_DIR)/smoketest: $(TEST_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(TEST_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(CURL_LIBS)

lib: $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)

$(BUILD_DIR)/$(CORE_LIB): $(CORE_OBJS)
	$(AR) rcs $@ $(CORE_OBJS)

$(BUILD_DIR)/$(TOOLS_LIB): $(TOOLS_OBJS)
	$(AR) rcs $@ $(TOOLS_OBJS)

cli: $(BUILD_DIR)/$(CLI_BIN)

$(BUILD_DIR)/$(CLI_BIN): $(CLI_OBJ) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(CLI_OBJ) \
	    $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) \
	    $(CURL_LIBS)

tui: $(BUILD_DIR)/$(TUI_BIN)

$(BUILD_DIR)/$(TUI_BIN): $(TUI_OBJS) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB)
	$(CXX) $(CXXFLAGS) -o $@ $(TUI_OBJS) \
	    $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) $(BUILD_DIR)/$(CORE_LIB) $(BUILD_DIR)/$(TOOLS_LIB) \
	    $(CURL_LIBS) $(NCURSES_LIBS)

# Object compilation rules. The library and tools are compiled once into the
# archive; the CLI/TUI only link against it.
$(BUILD_DIR)/lib/%.o: $(SRC_DIR)/lib/%.cpp
	@mkdir -p $(BUILD_DIR)/lib
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/src/%.o: $(SRC_DIR)/src/%.cpp
	@mkdir -p $(BUILD_DIR)/src
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/bench/%.o: $(SRC_DIR)/bench/%.cpp
	@mkdir -p $(BUILD_DIR)/bench
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/tui/%.o: $(SRC_DIR)/tui/%.cpp
	@mkdir -p $(BUILD_DIR)/tui
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) $(NCURSES_CFLAGS) -c $< -o $@

$(BUILD_DIR)/third_party/md4c/%.o: $(SRC_DIR)/third_party/md4c/%.c
	@mkdir -p $(BUILD_DIR)/third_party/md4c
	$(CC) $(CFLAGS) $(DEPFLAGS) -DMD4C_USE_UTF8 -I$(SRC_DIR)/third_party/md4c -c $< -o $@

$(BUILD_DIR)/tools/%.o: $(SRC_DIR)/tools/%.cpp
	@mkdir -p $(BUILD_DIR)/tools/search
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) -c $< -o $@

# One rule for every bundled plugin directory: adding a plugin means adding
# its object to the list above and a directory under plugins/, nothing else.
$(BUILD_DIR)/plugins/%/%.o: $(SRC_DIR)/plugins/%/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) -I$(SRC_DIR)/include -I$(SRC_DIR) $(CURL_CFLAGS) -c $< -o $@

$(BUILD_DIR)/tests/%.o: $(SRC_DIR)/tests/%.cpp
	@mkdir -p $(BUILD_DIR)/tests
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(DEPFLAGS) $(CURL_CFLAGS) $(NCURSES_CFLAGS) -c $< -o $@

# MCP fixture binaries: standalone (header-only json dependency only), no
# libagent link — they stand in for remote servers as external processes.
$(BUILD_DIR)/tests/fixtures/%: $(SRC_DIR)/tests/fixtures/%.cpp
	@mkdir -p $(BUILD_DIR)/tests/fixtures
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -o $@ $< -pthread

# Pull in auto-generated header dependencies (ignored if absent, e.g. first run).
-include $(CORE_OBJS:.o=.d)
-include $(TOOLS_OBJS:.o=.d)
-include $(CLI_OBJ:.o=.d)
-include $(BENCH_OBJS:.o=.d)
-include $(BENCH_MAIN:.o=.d)
-include $(TUI_OBJS:.o=.d)
-include $(UNITTEST_OBJ:.o=.d)
-include $(TEST_OBJ:.o=.d)
-include $(BENCH_TEST_OBJ:.o=.d)
-include $(CL_TEST_OBJ:.o=.d)
-include $(SB_TEST_OBJ:.o=.d)
-include $(PTY_TEST_OBJ:.o=.d)
-include $(E2E_TEST_OBJ:.o=.d)
-include $(COMP_TEST_OBJ:.o=.d)
-include $(TUI_TEST_OBJ:.o=.d)
-include $(PLUGIN_TEST_OBJ:.o=.d)
-include $(BUILD_DIR)/third_party/md4c/md4c.d
# Bundled plugin objects generate .d files (the pattern rule uses DEPFLAGS) but
# were missing from this list, so a change to a header they include — including
# IPlugin itself — silently left them stale. With IPlugin's vtable that is not a
# warning, it is a jump through the wrong slot.
-include $(wildcard $(BUILD_DIR)/plugins/*/*.d)
-include $(WS_TEST_OBJ:.o=.d)
-include $(CDP_WS_OBJ:.o=.d)
-include $(CDP_MAIN_OBJ:.o=.d)
-include $(CDP_URL_OBJ:.o=.d)
-include $(URL_TEST_OBJ:.o=.d)
-include $(SYSINFO_PLUGIN).d
-include $(BUILD_DIR)/ws_test.d

datadir    = $(datarootdir)/amber

install: all
	install -d $(DESTDIR)$(bindir)
	install -m 755 $(BUILD_DIR)/$(CLI_BIN) $(DESTDIR)$(bindir)/
	install -m 755 $(BUILD_DIR)/$(TUI_BIN) $(DESTDIR)$(bindir)/
	install -m 755 $(BUILD_DIR)/$(BENCH_BIN) $(DESTDIR)$(bindir)/
	install -d $(DESTDIR)$(libdir)
	install -m 644 $(BUILD_DIR)/$(CORE_LIB) $(DESTDIR)$(libdir)/
	install -m 644 $(BUILD_DIR)/$(TOOLS_LIB) $(DESTDIR)$(libdir)/
	install -d $(DESTDIR)$(includedir)/agent
	install -d $(DESTDIR)$(includedir)/nlohmann
	install -m 644 $(SRC_DIR)/include/agent/*.h $(DESTDIR)$(includedir)/agent/
	install -d $(DESTDIR)$(datadir)/prompts
	install -m 644 prompts/*.md $(DESTDIR)$(datadir)/prompts/
	install -d $(DESTDIR)$(datadir)/prompts/tools
	install -m 644 prompts/tools/*.md $(DESTDIR)$(datadir)/prompts/tools/
	install -m 644 completions.json $(DESTDIR)$(datadir)/
	install -d $(DESTDIR)$(datadir)/plugins/sysinfo
	install -m 755 $(SYSINFO_PLUGIN) $(DESTDIR)$(datadir)/plugins/sysinfo/
	install -m 644 tools/plugins/sysinfo/manifest.json $(DESTDIR)$(datadir)/plugins/sysinfo/
	install -m 644 $(SRC_DIR)/include/nlohmann/json.hpp $(DESTDIR)$(includedir)/nlohmann/
	install -d $(DESTDIR)$(docdir)
	install -m 644 $(SRC_DIR)/LICENSE $(DESTDIR)$(docdir)/
	install -m 644 $(SRC_DIR)/NOTICE $(DESTDIR)$(docdir)/
	install -m 644 $(SRC_DIR)/THIRD_PARTY_LICENSES $(DESTDIR)$(docdir)/
	install -m 644 $(SRC_DIR)/README.md $(DESTDIR)$(docdir)/

uninstall:
	rm -f $(DESTDIR)$(bindir)/$(CLI_BIN)
	rm -f $(DESTDIR)$(bindir)/$(TUI_BIN)
	rm -f $(DESTDIR)$(bindir)/$(BENCH_BIN)
	rm -f $(DESTDIR)$(libdir)/$(CORE_LIB)
	rm -f $(DESTDIR)$(libdir)/$(TOOLS_LIB)
	rm -rf $(DESTDIR)$(includedir)/agent
	rm -rf $(DESTDIR)$(docdir)

clean:
	rm -f $(BUILD_DIR)/lib/*.o $(BUILD_DIR)/lib/*.d
	rm -f $(BUILD_DIR)/src/*.o $(BUILD_DIR)/src/*.d
	rm -f $(BUILD_DIR)/tui/*.o $(BUILD_DIR)/tui/*.d
	rm -f $(BUILD_DIR)/tests/*.o $(BUILD_DIR)/tests/*.d
	rm -f $(BUILD_DIR)/bench/*.o $(BUILD_DIR)/bench/*.d
	rm -f $(BUILD_DIR)/tools/*.o $(BUILD_DIR)/tools/*.d
	rm -f $(BUILD_DIR)/tools/search/*.o $(BUILD_DIR)/tools/search/*.d
	rm -f $(BUILD_DIR)/third_party/md4c/*.o $(BUILD_DIR)/third_party/md4c/*.d
	rm -f $(SYSINFO_PLUGIN) $(SYSINFO_PLUGIN).d $(CDP_PLUGIN)
	rm -f $(BUILD_DIR)/tools/plugins/cdp/*.o $(BUILD_DIR)/tools/plugins/cdp/*.d
	rm -f $(BUILD_DIR)/plugins/*/*.o $(BUILD_DIR)/plugins/*/*.d
	rm -f $(BUILD_DIR)/ws_test.d
	rm -rf $(FUZZ_BIN)
	rm -f $(BUILD_DIR)/url_test $(BUILD_DIR)/url_test.d
	rm -f $(CORE_LIB) $(TOOLS_LIB) $(CLI_BIN) $(TUI_BIN) $(BENCH_BIN)
	rm -f $(BUILD_DIR)/run_tests $(BUILD_DIR)/command_line_test $(BUILD_DIR)/session_browser_test $(BUILD_DIR)/e2e_test $(BUILD_DIR)/completions_test $(BUILD_DIR)/plugin_test $(BUILD_DIR)/ws_test $(BUILD_DIR)/url_test $(BUILD_DIR)/bench_test $(BUILD_DIR)/tui_pty_test $(BUILD_DIR)/smoketest
	rm -f $(BUILD_DIR)/tests/fixtures/mcp_echo $(BUILD_DIR)/tests/fixtures/mcp_http $(BUILD_DIR)/tests/fixtures/mcp_ignore_sigterm
	rm -rf $(BUILD_DIR)/tests/fixtures/*.dSYM $(BUILD_DIR)/*.dSYM
	rm -f $(BUILD_DIR)/run_command_line_test $(BUILD_DIR)/run_completions_test $(BUILD_DIR)/run_e2e_test
	rm -f amber-smoke.txt
	# Coverage droppings. A `--coverage` build (the coverage job, or a local run)
	# scatters .gcno next to every object and writes .gcda beside the sources.
	# Leaving them behind means a later build picks up stale counters, and they
	# show up as untracked files in git status.
	find $(SRC_DIR) -name '*.gcno' -o -name '*.gcda' | xargs rm -f
