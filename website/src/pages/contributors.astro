---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
---

<BaseLayout title="Contributors" description="amber contributors — who makes this possible">
  <NavBar />
  <main>
    <h1>Contributors</h1>

    <section class="section">
      <p>
        amber is a community project. Anyone can contribute — code, docs, bug reports,
        feature ideas. All participation is governed by our Code of Conduct.
      </p>
    </section>

    <hr class="divider-thick" />

    <section class="section">
      <h2>Core Team</h2>
      <ul class="feature-list">
        <li><strong>Jacek Trefon</strong> — creator and maintainer. 28 years in tech, 15 years in leadership. MBA, DBA. Based near San Pedro (Murcia).</li>
      </ul>
    </section>

    <hr class="divider" />

    <section class="section">
      <h2>How to Contribute</h2>
      <p>See <a href="/contributing">CONTRIBUTING.md</a> for detailed instructions.</p>
      <ul class="feature-list">
        <li>Fork the repo and create a topic branch</li>
        <li>Make focused commits with clear messages (imperative mood)</li>
        <li>Ensure <code>make && make test</code> pass locally</li>
        <li>Open a pull request describing the change and how you verified it</li>
      </ul>
    </section>

    <hr class="divider" />

    <section class="section">
      <h2>Reporting Bugs</h2>
      <p>Use the GitHub issue templates. For security issues, see the security notes in the README rather than filing a public issue.</p>
    </section>

    <hr class="divider" />

    <section class="section">
      <h2>License</h2>
      <p>By contributing, you agree that your contributions are licensed under the Apache License 2.0.</p>
    </section>
  </main>
</BaseLayout>
