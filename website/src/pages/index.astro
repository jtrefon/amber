---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import AsciiHero from '../components/AsciiHero.astro';
import Diagram from '../components/Diagram.astro';
import { site } from '../data/site';

const terminalSession = `$ ./amber
───────────────────────────────────────────────────────────────
 amber ${site.version}  |  ${site.license}  |  C++17  |  ncurses
───────────────────────────────────────────────────────────────

[system] Loading configuration...
[system] Provider: custom:local-llama (llama-turboq)
[system] Model: Qwopus-27B-Fusion
[system] Workspace: /home/jack/projects
[system] Ready.

amber ~ $ /set model qwopus-27b
[model] Switched to qwopus-27b

amber ~ $ Search for TODO comments in src/
[tool] search_files: pattern="TODO" in /home/jack/projects/src/
  → 12 matches found in 4 files

[agent] I found 12 TODO comments. Here's a summary:
  - src/agent/context.cpp:12, Optimize hash chain lookup
  - src/tui/drawer.cpp:45, Add scroll buffering
  - src/tools/search.cpp:88, Support regex alternation
  ...

[compress] Classify: 248 messages → core: 12, context: 18, prune: 218
[compress] Extract: 3 memory ops, 2 skill ops
[compress] Prune: replaced 218 bulky outputs with placeholders
[compress] Headroom: 25% enforced (186/736 tokens)
[compress] Done: 248 → 30 messages (87.9% reduction)

amber ~ $ █`;
---

<BaseLayout title={site.title} description={site.description}>
  <NavBar />
  <main>
    <AsciiHero />

    <hr class="divider-thick" />

    <!-- What Amber is -->
    <section class="section">
      <h2>What is Amber?</h2>
      <p>
        Amber is a native C++17 AI agent runtime and CLI harness for building
        and running tool-using agents.
      </p>
      <p>
        Its core is deliberately extensible: providers, tools and UI
        capabilities use the same plugin architecture, allowing Amber to grow
        without hardcoding every integration into the runtime.
      </p>
      <p>
        Use the interactive terminal UI, run the headless CLI in automation, or
        embed the native runtime in another C++ project.
      </p>
    </section>

    <hr class="divider" />

    <!-- What Amber can do -->
    <section class="section">
      <h2>What Amber can do</h2>
      <div class="cap-grid">
        <div class="cap">
          <h3>Work with code and files</h3>
          <ul>
            <li>Read and modify files</li>
            <li>Search project trees</li>
            <li>Semantic / local search</li>
            <li>Work inside a confined workspace</li>
          </ul>
        </div>
        <div class="cap">
          <h3>Execute and automate</h3>
          <ul>
            <li>Run shell commands</li>
            <li>Track jobs</li>
            <li>Apply approval gates to side-effecting operations</li>
            <li>Run headless from scripts and automation</li>
          </ul>
        </div>
        <div class="cap">
          <h3>Connect</h3>
          <ul>
            <li>Multiple LLM / provider implementations</li>
            <li>MCP servers</li>
            <li>Provider-specific dialects</li>
            <li>Extensible provider plugins</li>
          </ul>
        </div>
        <div class="cap">
          <h3>Delegate</h3>
          <ul>
            <li>Sub-agents</li>
            <li>Parallel / serial delegation</li>
            <li>Shared runtime infrastructure</li>
          </ul>
        </div>
        <div class="cap">
          <h3>Manage long-running sessions</h3>
          <ul>
            <li>Context compression</li>
            <li>Memory / skill mechanisms</li>
            <li>Context integrity protections</li>
            <li>Runtime telemetry</li>
          </ul>
        </div>
        <div class="cap">
          <h3>Extend</h3>
          <ul>
            <li>Plugin / capability architecture</li>
            <li>Provider capabilities</li>
            <li>Tool capabilities</li>
            <li>UI / status / panel capabilities</li>
          </ul>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- Everything is a capability -->
    <section class="section">
      <h2>Everything is a capability</h2>
      <p>
        Amber's core does not need to know every provider, tool or extension
        that exists. Capabilities are contributed through the plugin
        architecture and installed by the runtime. Providers, tools and UI
        extensions use the same underlying mechanism, so new integrations do
        not require special cases throughout the agent core.
      </p>
      <p>
        Plugins can be enabled, disabled and unwound cleanly, with
        contributions tracked by owner.
      </p>
      <p>
        <a class="cta-link" href="/plugins">Build a plugin →</a>
      </p>
    </section>

    <hr class="divider" />

    <!-- Why C++ -->
    <section class="section">
      <h2>Why C++?</h2>
      <p>
        Amber is compiled C++17 from the runtime up. The agent loop, context
        management, tools, plugin system and clients share the same native
        core.
      </p>
      <p>
        The result is a small, explicit runtime with no Python or Node
        dependency, while the core remains usable as a library rather than
        being tied to a single interface.
      </p>
      <Diagram
        name="runtimeOverview"
      />
    </section>

    <hr class="divider" />

    <!-- One runtime, multiple clients -->
    <section class="section">
      <h2>One runtime, multiple clients</h2>
      <div class="four-parts">
        <div class="part">
          <h3>libagent / core runtime</h3>
          <p class="part-tag">the engine</p>
          <p>
            Native agent runtime containing the agent loop, context, tools,
            plugin runtime and supporting infrastructure. It can be linked
            into another C++ application rather than requiring the interactive
            Amber client.
          </p>
        </div>
        <div class="part">
          <h3>amber</h3>
          <p class="part-tag">interactive terminal UI</p>
          <p>
            The primary interactive client with the retro IRC/BitchX-inspired
            multi-window interface, sessions, slash commands, jobs, plugin
            controls, approval dialogs and runtime telemetry.
          </p>
        </div>
        <div class="part">
          <h3>amber-cli</h3>
          <p class="part-tag">headless agent</p>
          <p>
            For scripts, CI, automation, scheduled jobs and environments where
            an interactive TTY is unnecessary.
          </p>
        </div>
        <div class="part">
          <h3>amber-bench</h3>
          <p class="part-tag">evaluation harness</p>
          <p>
            Runs repeatable scenarios against the same agent engine and
            produces measurable results using scenario / oracle scoring.
          </p>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- Multi-provider -->
    <section class="section">
      <h2>Bring your model. Keep the runtime.</h2>
      <p>
        Amber separates the agent runtime from the model provider. Provider
        integrations live behind the same plugin architecture, allowing the
        harness to work with different vendors and OpenAI-compatible endpoints
        without changing the agent loop.
      </p>
      <p class="provider-note">
        Bundled provider plugins: Anthropic, Gemini, OpenRouter, DeepSeek,
        KiloCode, OpenCode, CommandCode, Custom, and OpenAI-compatible
        endpoints.
      </p>
    </section>

    <hr class="divider" />

    <!-- MCP and sub-agents -->
    <section class="section">
      <div class="cap-grid">
        <div class="cap">
          <h3>MCP</h3>
          <p>
            Connect Amber to MCP servers over the supported transports and
            extend the agent with external tools and services.
          </p>
        </div>
        <div class="cap">
          <h3>Sub-agents</h3>
          <p>
            Delegate work to sub-agents through the same runtime, with support
            for serial and parallel execution.
          </p>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- Security -->
    <section class="section">
      <h2>Agents should not get a blank cheque</h2>
      <p>
        Amber treats model output as untrusted input. Filesystem operations are
        confined to the workspace, side-effecting operations can require
        approval, shell execution is gated, and jobs are isolated and bounded.
      </p>
      <p>
        The goal is not to pretend an agent is safe by default. The goal is to
        make its trust boundaries explicit.
      </p>
    </section>

    <hr class="divider" />

    <!-- Benchmarks -->
    <section class="section">
      <h2>Measure the harness, not the demo</h2>
      <p>
        Amber includes its own benchmark and evaluation harness so changes to
        the runtime can be tested against repeatable scenarios rather than
        judged from a few impressive demos.
      </p>
      <p>
        <a class="cta-link" href="/benchmarks">Full results and methodology →</a>
      </p>
    </section>

    <hr class="divider" />

    <!-- Platforms -->
    <section class="section">
      <h2>Where it runs</h2>
      <div class="cap-grid">
        <div class="cap">
          <h3>macOS</h3>
          <p>Apple Silicon binaries available. Install via Homebrew.</p>
          <div class="terminal">
            <pre>brew install jtrefon/homebrew-amber/amber-agent</pre>
          </div>
        </div>
        <div class="cap">
          <h3>Linux</h3>
          <p>Prebuilt Linux binaries and build-from-source options.</p>
          <div class="terminal">
            <pre># .deb / .rpm / tarball
# or build from source:
git clone https://github.com/jtrefon/amber
cd amber && make</pre>
          </div>
        </div>
      </div>
      <p>
        <a class="cta-link" href="/download">Get Amber →</a>
        &nbsp;·&nbsp;
        <a href="/install">Build from source</a>
      </p>
    </section>

    <hr class="divider" />

    <!-- Final invitation -->
    <section class="section">
      <h2>Try it. Break it. Contribute.</h2>
      <p>
        Amber is open source ({site.license}) and currently beta. The project
        is ready for people to try, inspect and contribute to.
      </p>
      <div class="cta-row">
        <a href="/download" class="cta-link">./try</a>
        <a href={site.repo} target="_blank" rel="noopener" class="cta-link">github.com/jtrefon/amber</a>
      </div>
      <p class="report-line">
        Found something broken, or have an idea?
        <a href={site.issues.newBug} target="_blank" rel="noopener">Report a bug</a>
        &nbsp;·&nbsp;
        <a href={site.issues.newFeature} target="_blank" rel="noopener">Request a feature</a>
        &nbsp;·&nbsp;
        <a href="/report">All the ways to contribute</a>
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin: 20px 0;
  }

  .cap {
    border: 1px solid #33260e;
    background: #0a0700;
    padding: 16px;
  }

  .cap h3 {
    color: #ffcf4d;
    font-size: 0.95em;
    margin: 0 0 10px;
    text-shadow: 0 0 8px rgba(255, 176, 0, 0.45);
  }

  .cap ul {
    color: #9a7c47;
    font-size: 13px;
    line-height: 1.7;
    margin: 0;
    padding-left: 18px;
  }

  .cap p {
    color: #9a7c47;
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
  }

  .cap .terminal {
    margin-top: 10px;
    font-size: 12px;
  }

  .four-parts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 20px 0;
  }

  .part {
    border: 1px solid #33260e;
    background: #0a0700;
    padding: 16px;
  }

  .part h3 {
    color: #ffcf4d;
    font-size: 0.95em;
    margin: 0 0 4px;
    text-shadow: 0 0 8px rgba(255, 176, 0, 0.45);
  }

  .part .part-tag {
    color: #6b4f1f;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .part p {
    color: #9a7c47;
    font-size: 13px;
    line-height: 1.6;
  }

  .provider-note {
    color: #6b4f1f;
    font-size: 12px;
    font-family: 'JetBrains Mono', monospace;
  }

  .cta-row {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cta-link {
    font-weight: bold;
    font-size: 14px;
  }

  .report-line {
    margin-top: 20px;
    font-size: 13px;
    color: #9a7c47;
  }
</style>
