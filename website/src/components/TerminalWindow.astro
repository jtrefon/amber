---
interface Props {
  title?: string;
  content: string;
}

const { title = 'amber ~ $', content } = Astro.props;
---

<div class="terminal-window">
  <div class="terminal-header">
    <span class="terminal-dots"><span></span><span></span><span></span></span>
    <span class="terminal-title">{title}</span>
  </div>
  <div class="terminal-body">
    <pre>{content}</pre>
  </div>
</div>

<style>
  .terminal-window {
    background: #0a0700;
    border: 1px solid #33260e;
    margin: 24px 0;
    overflow: hidden;
    box-shadow:
      0 0 16px rgba(255, 176, 0, 0.05),
      inset 0 0 30px rgba(255, 176, 0, 0.03);
  }

  .terminal-header {
    background: #120c02;
    padding: 7px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px dashed #33260e;
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
    margin-right: 12px;
  }

  .terminal-dots span {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #6b4f1f;
  }

  .terminal-dots span:first-child {
    background: #ffb000;
    box-shadow: 0 0 6px rgba(255, 176, 0, 0.6);
  }

  .terminal-title {
    color: #9a7c47;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
  }

  .terminal-body {
    padding: 16px 20px;
    overflow-x: auto;
  }

  .terminal-body pre {
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.6;
    color: #e8cf9c;
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
