---
import asciiArt from '../data/ascii-hero.html?raw';
import { site } from '../data/site';
---

<div class="ascii-hero">
  <p class="art-meta">[ art.ans · 120×33 · ANSI/256 ]</p>
  <div class="ascii-art-container">
    <Fragment set:html={asciiArt} />
  </div>

  <h1 class="tagline">
    a native C++ AI agent runtime and CLI harness<span class="cursor">█</span>
  </h1>
  <p class="pitch">
    Built as a native C++17 runtime, not a collection of scripts around an API.<br />
    Extensible providers, tools and capabilities through one plugin architecture.<br />
    Interactive TUI or headless CLI, running on Linux and macOS.
  </p>
  <div class="cta-row">
    <a href="/download" class="cta">./try</a>
    <a href={site.repo} target="_blank" rel="noopener" class="cta outline">github.com/jtrefon/amber</a>
    <a href="/architecture" class="cta outline">./architecture</a>
  </div>

  <div class="beta-notice">
    <p class="beta-label">Beta</p>
    <p class="beta-text">
      Amber is usable today, but still evolving. If you try it, feedback is
      genuinely useful, especially things that feel confusing, incomplete or
      broken.
    </p>
  </div>
</div>

<style>
  .ascii-hero {
    text-align: center;
    padding: 32px 0 24px;
  }

  .art-meta {
    color: #6b4f1f;
    font-size: 11px;
    letter-spacing: 2px;
    margin: 0 auto 8px;
    text-align: center;
  }

  .ascii-art-container {
    display: flex;
    justify-content: center;
    margin: 0 auto;
    overflow-x: auto;
    max-width: 100%;
    background: #000000;
    border: 1px solid #33260e;
    box-shadow:
      0 0 30px rgba(255, 176, 0, 0.07),
      inset 0 0 40px rgba(255, 176, 0, 0.03);
  }

  .ascii-art-container :global(pre.ascii-art) {
    background: #000000;
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 7px;
    line-height: 1;
    letter-spacing: 0;
    user-select: none;
  }

  .ascii-hero .tagline {
    color: #ffb000;
    font-size: 1.15em;
    font-weight: bold;
    margin: 28px 0 16px;
    text-shadow: 0 0 10px rgba(255, 176, 0, 0.5);
  }

  .ascii-hero .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.2em;
    background: #ffb000;
    box-shadow: 0 0 10px rgba(255, 176, 0, 0.6);
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .ascii-hero .pitch {
    color: #9a7c47;
    font-size: 0.95em;
    line-height: 1.8;
    margin-bottom: 32px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta {
    display: inline-block;
    background: #0a0700;
    border: 1px solid #ffb000;
    padding: 10px 24px;
    color: #ffb000;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
    text-shadow: 0 0 6px rgba(255, 176, 0, 0.5);
    transition: background 0.2s, color 0.2s;
  }

  .cta:hover {
    background: rgba(255, 176, 0, 0.12);
    color: #ffcf4d;
    border-color: #ffcf4d;
  }

  .cta.outline {
    border-color: #6b4f1f;
    color: #9a7c47;
    text-shadow: none;
  }

  .cta.outline:hover {
    border-color: #ffb000;
    color: #ffb000;
    text-shadow: 0 0 6px rgba(255, 176, 0, 0.5);
  }

  .beta-notice {
    margin: 32px auto 0;
    max-width: 560px;
    border: 1px solid #33260e;
    background: #0a0700;
    padding: 16px 24px;
    text-align: left;
  }

  .beta-label {
    color: #ffb000;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 8px;
    text-shadow: 0 0 6px rgba(255, 176, 0, 0.4);
  }

  .beta-text {
    color: #9a7c47;
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
  }
</style>
