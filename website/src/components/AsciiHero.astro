---
import asciiArt from '../data/ascii-hero.html?raw';
---

<div class="ascii-hero">
  <div class="ascii-art-container">
    <Fragment set:html={asciiArt} />
  </div>

  <p class="tagline">
    an AI agent harness for Linux servers<span class="cursor">█</span>
  </p>
  <p class="pitch">
    The only C++17 agent harness in the field — compiled, not scripted.<br />
    One binary, no Python, no Node, no accounts, no telemetry.<br />
    A BitchX-inspired TUI, real benchmarks, compression that works.
  </p>
  <div class="cta-row">
    <a href="/install" class="cta">Install</a>
    <a href="https://github.com/jtrefon/amber" target="_blank" rel="noopener" class="cta outline">GitHub</a>
  </div>
</div>

<style>
  .ascii-hero {
    text-align: center;
    padding: 32px 0;
  }

  .ascii-art-container {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
    overflow-x: auto;
    max-width: 100%;
  }

  .ascii-art-container :global(pre.ascii-art) {
    background: #0a0a0a;
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 7px;
    line-height: 1;
    letter-spacing: 0;
    user-select: none;
  }

  .ascii-hero .tagline {
    color: #ff6b35;
    font-size: 1.1em;
    font-weight: bold;
    margin-bottom: 16px;
  }

  .ascii-hero .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.2em;
    background: #00ff41;
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .ascii-hero .pitch {
    color: #888888;
    font-size: 0.95em;
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-row {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  .cta {
    display: inline-block;
    background: #1a1a1a;
    border: 1px solid #00ff41;
    padding: 10px 24px;
    color: #00ff41;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta:hover {
    background: rgba(0, 255, 65, 0.1);
  }

  .cta.outline {
    border-color: #888888;
    color: #888888;
  }

  .cta.outline:hover {
    border-color: #00ff41;
    color: #00ff41;
  }
</style>
